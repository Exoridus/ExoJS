#!/usr/bin/env sh
# Pre-push verification.
#
# Branch pushes:  `scripts/ci/push-scope.ts` handles empty and published-data
#                 ranges. Other pushes run path-aware static gates and local
#                 test lanes against the pushed range. CI retains its complete
#                 affected matrix. An unknown range takes the full local path.
#
#                 The point of running suites here rather than leaving them to
#                 CI: a push that fails remote costs a round trip and blocks an
#                 auto-merge, and every lane below is one a developer could have
#                 run locally in less time than that round trip takes. What it
#                 does NOT run is a lane the change cannot affect - a src-only
#                 change never waits for the audio or tilemap-worker browser
#                 lanes.
# Tag pushes:     `scripts/ci/trust.ts` - the release workflow's own admission
#                 check: the tagged commit carries the package.json version,
#                 sits on origin/main and has a green `verdict`. Nothing is
#                 re-verified locally because CI already ran every lane on the
#                 push that brought the commit to main; a tag that would be
#                 rejected remotely is rejected here first.
#
# Refs being pushed are read from stdin in the format:
#   <local_ref> <local_sha> <remote_ref> <remote_sha>
is_tag_push=0
EXOJS_OUTPUT=${EXOJS_OUTPUT:-compact}
export EXOJS_OUTPUT
is_branch_push=0
pushed_tags=""
push_head_sha=""
push_base_sha=""
null_sha="0000000000000000000000000000000000000000"

while read local_ref local_sha remote_ref remote_sha; do
    # Deletions carry the null SHA; nothing to verify when removing a ref.
    [ "$local_sha" = "$null_sha" ] && continue
    case "$remote_ref" in
        refs/tags/*)
            is_tag_push=1
            pushed_tags="$pushed_tags ${remote_ref#refs/tags/}"
            ;;
        *)
            is_branch_push=1
            # Only the last pushed branch ref wins when a push carries several
            # refs at once; same simplification the pre-existing boolean
            # flags above already make; a multi-branch push is a rare edge
            # case and this hook is a convenience, not a hard gate.
            push_head_sha="$local_sha"
            [ "$remote_sha" != "$null_sha" ] && push_base_sha="$remote_sha"
            ;;
    esac
done

if [ "$is_tag_push" = "1" ]; then
    echo "[pre-push] tag push detected - checking the tagged commit is releasable"
    git fetch --quiet origin main || exit 1
    for tag in $pushed_tags; do
        node scripts/ci/trust.ts "$tag" || exit 1
    done
fi

if [ "$is_branch_push" = "1" ]; then
    # Existing remote SHA scopes incremental pushes; a new branch uses the
    # merge base with origin/HEAD. An unresolved base runs everything.
    lane_base=$(node scripts/ci/push-range.ts "$push_head_sha" "${push_base_sha:-$null_sha}") || exit 1
    echo "[pre-push] validation base ${lane_base:-unknown}"

    # How much of the above the range actually needs. `full` for anything
    # `push-scope.ts` does not positively recognise, including an undeterminable
    # range, so a narrower answer is always a deliberate one.
    scope=$(node scripts/ci/push-scope.ts "$lane_base" "$push_head_sha")

    case "$scope" in
        none)
            echo "[pre-push] the pushed range changes no tracked file - nothing to verify"
            ;;
        data)
            echo "[pre-push] published benchmark data only - running its own gate"
            npm run verify:bench-results || exit 1
            ;;
        *)
            # Dist consumers need the current build before their gates run.
            needs_dist=$(node scripts/ci/local-policy.ts --needs-dist "$lane_base" "$push_head_sha") || exit 1
            if [ "$needs_dist" = "true" ]; then
                echo "[pre-push] checking dist against the sources"
                node scripts/check-dist-fresh.ts --rebuild || exit 1
            fi

            echo "[pre-push] static validation"
            npm run gates -- affected "$lane_base" "$push_head_sha" || exit 1

            if [ -n "$lane_base" ]; then
                echo "[pre-push] running the test lanes this push requires"
                npm run lanes -- --run --tests-only --base "$lane_base" || exit 1
            else
                echo "[pre-push] no base commit to scope lanes against - running every lane"
                npm run lanes -- --run --tests-only --all || exit 1
            fi
            ;;
    esac
fi
