#!/usr/bin/env sh
# Refuse commits made directly on the default branch.
#
# `main` is protected by a server-side ruleset and only ever advances through a
# reviewed PR, so a local commit sitting on `main` cannot reach the remote — it
# just makes the local branch diverge from `origin/main`. That divergence is the
# problem: the next `git pull` on a diverged branch silently builds a merge
# commit, and the resulting history has to be untangled by hand later.
#
# The companion safeguard for that second half is `git config pull.ff only`,
# which turns a diverged pull into a loud failure instead of a quiet merge. It
# lives in `.git/config` and therefore cannot be committed — see CONTRIBUTING.md
# for the one-time setup.
#
# Escape hatch for the rare legitimate case (a release version bump prepared on
# the default branch):
#
#   ALLOW_MAIN_COMMIT=1 git commit ...

branch=$(git branch --show-current)

# A detached HEAD (rebase, bisect, `git commit` during a merge resolution) has
# no branch name — never block those.
[ -z "$branch" ] && exit 0

case "$branch" in
    main | master)
        [ "$ALLOW_MAIN_COMMIT" = "1" ] && exit 0

        echo "refusing to commit directly on '$branch'." >&2
        echo >&2
        echo "  Create a branch first:" >&2
        echo "    git switch -c <type>/<short-description>" >&2
        echo >&2
        echo "  Already staged? The commit is preserved — branching keeps the index:" >&2
        echo "    git switch -c <type>/<short-description> && git commit" >&2
        echo >&2
        echo "  Deliberate exception (e.g. a release bump):" >&2
        echo "    ALLOW_MAIN_COMMIT=1 git commit ..." >&2
        exit 1
        ;;
esac

# Format and auto-fix what is about to be committed.
#
# The pre-push gate runs `format:check` and `lint:all` over the whole tree, so a
# file that reaches a commit unformatted is only found once the push is already
# underway - at which point the fix has to be amended into a commit that exists.
# Running the writers here, on the staged paths only, keeps the commit itself
# clean and the push gate quiet.
#
# Skip it for a commit that is not about content (a rebase, a merge resolution):
#
#   SKIP_LINT_STAGED=1 git commit ...

[ "$SKIP_LINT_STAGED" = "1" ] && exit 0

npx --no-install lint-staged
