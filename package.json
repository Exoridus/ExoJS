{
  "name": "@codexo/exojs",
  "description": "A TypeScript-first browser 2D runtime for games and interactive apps.",
  "version": "0.16.1",
  "type": "module",
  "packageManager": "pnpm@11.4.0",
  "files": [
    "dist/esm/",
    "dist/exo.esm.js",
    "dist/exo.esm.js.map",
    "dist/exo.debug.esm.js",
    "dist/exo.debug.esm.js.map",
    "dist/exo.iife.js",
    "dist/exo.iife.js.map",
    "dist/exo.iife.min.js",
    "dist/exo.iife.min.js.map",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "main": "./dist/exo.esm.js",
  "module": "./dist/esm/index.js",
  "browser": "./dist/exo.esm.js",
  "types": "./dist/esm/index.d.ts",
  "sideEffects": [
    "./dist/esm/rendering/sprite/Sprite.js",
    "./dist/esm/core/Logger.js",
    "./dist/esm/ui/theme.js"
  ],
  "keywords": [
    "2d",
    "browser",
    "canvas",
    "games",
    "rendering",
    "typescript",
    "webgl2",
    "webgpu"
  ],
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "default": "./dist/esm/index.js"
    },
    "./extensions": {
      "types": "./dist/esm/extensions/index.d.ts"
    },
    "./renderer-sdk": {
      "types": "./dist/esm/renderer-sdk.d.ts",
      "import": "./dist/esm/renderer-sdk.js",
      "default": "./dist/esm/renderer-sdk.js"
    },
    "./debug": {
      "types": "./dist/esm/debug/index.d.ts",
      "import": "./dist/esm/debug/index.js",
      "default": "./dist/esm/debug/index.js"
    },
    "./package.json": "./package.json"
  },
  "imports": {
    "#*.vert": "./src/*.vert",
    "#*.frag": "./src/*.frag",
    "#*": {
      "@codexo/exojs-source": "./src/*.ts",
      "types": "./dist/esm/*.d.ts",
      "default": "./dist/esm/*.js"
    }
  },
  "prettier": "@codexo/exojs-config/prettier",
  "lint-staged": {
    "*.{ts,tsx,mts,cts,mjs,js,json,jsonc,md,mdx,css,yml,yaml,html}": "prettier --write",
    "{src,test,examples,scripts,packages}/**/*.{ts,tsx,mts,cts}": "eslint --fix --no-warn-ignored --max-warnings=0"
  },
  "scripts": {
    "bootstrap": "pnpm install --frozen-lockfile --ignore-scripts && pnpm build:tooling",
    "build:tooling": "pnpm --filter @codexo/exojs-build build",
    "clean": "rimraf dist",
    "build": "pnpm build:tooling && pnpm clean && tsx scripts/build.ts",
    "build:dev": "pnpm build:tooling && pnpm clean && tsx scripts/build.ts --dev",
    "build:watch": "tsx scripts/build.ts --dev --watch",
    "verify:exports": "tsx ./scripts/verify-exports.ts",
    "verify:declaration-imports": "tsx ./scripts/verify-declaration-imports.ts",
    "verify:package-policy": "tsx ./scripts/verify-package-policy.ts",
    "verify:publint": "pnpm dlx publint@0.3.21 --strict . && pnpm --filter \"@codexo/exojs-build\" --filter \"@codexo/exojs-particles\" --filter \"@codexo/exojs-tilemap\" --filter \"@codexo/exojs-tiled\" --filter \"@codexo/exojs-physics\" --filter \"@codexo/exojs-tilemap-physics\" --filter \"@codexo/exojs-audio-fx\" exec pnpm dlx publint@0.3.21 --strict .",
    "verify:package": "pnpm build && pnpm verify:exports && pnpm verify:declaration-imports && pnpm pack",
    "verify:lockstep": "tsx ./scripts/verify-lockstep-versions.ts",
    "verify:release-matrix": "tsx ./scripts/verify-release-matrix.ts",
    "verify:create-exo-app": "tsx ./scripts/verify-create-exo-app.ts",
    "sync:example-capabilities": "tsx ./scripts/sync-example-capabilities.ts",
    "create:package": "tsx scripts/create-package.ts",
    "gate:bench:structural": "pnpm --filter @codexo/exojs-bench gate:structural",
    "gates": "tsx ./scripts/ci/gates.ts",
    "lanes": "tsx ./scripts/lanes.ts",
    "verify:quick": "pnpm gates all",
    "verify:ci": "pnpm verify:quick && pnpm test",
    "release": "tsx ./scripts/release.ts",
    "release:cut": "tsx ./scripts/release/cut.ts",
    "release:prepare": "tsx ./scripts/release/run.ts prepare",
    "release:full-zip": "tsx ./scripts/release/run.ts full-zip",
    "release:publish": "tsx ./scripts/release/run.ts publish",
    "release:bootstrap": "tsx ./scripts/release/run.ts bootstrap",
    "release:publish-independent": "tsx ./scripts/release/run.ts publish-independent",
    "verify:external-consumers": "tsx ./scripts/release/external-consumers.ts",
    "release:notes": "tsx ./scripts/generate-release-notes.ts",
    "docs:api:generate": "pnpm site:build:api",
    "docs:api:check": "tsx scripts/check-api-docs-sync.ts",
    "examples:sync:check": "tsx scripts/check-examples-sync.ts",
    "full-bundle:exports:check": "tsx scripts/check-full-bundle-exports.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:examples": "tsc --noEmit -p tsconfig.examples.json",
    "typecheck:workers": "tsc --noEmit -p tsconfig.workers.json",
    "typecheck:type-tests": "tsx scripts/typecheck-type-tests.ts",
    "typecheck:guides": "tsx scripts/check-guide-no-check-reasons.ts && tsx scripts/extract-guide-snippets.ts && tsx scripts/typecheck-guides.ts",
    "typecheck:guides:update-baseline": "tsx scripts/extract-guide-snippets.ts --update-baseline",
    "typecheck:guides:no-check": "tsx scripts/check-guide-no-check-reasons.ts",
    "typecheck:guides:no-check:update-baseline": "tsx scripts/check-guide-no-check-reasons.ts --update-baseline",
    "typecheck:packages": "pnpm --filter \"@codexo/exojs-build\" --filter \"@codexo/exojs-particles\" --filter \"@codexo/exojs-tilemap\" --filter \"@codexo/exojs-tiled\" --filter \"@codexo/exojs-physics\" --filter \"@codexo/exojs-tilemap-physics\" --filter \"@codexo/exojs-audio-fx\" --filter \"@codexo/exojs-aseprite\" --filter \"@codexo/exojs-ldtk\" --filter \"@codexo/exojs-react\" typecheck",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "typecheck:site": "pnpm --filter @codexo/exojs-examples check-ts",
    "typecheck:site-scripts": "pnpm --filter @codexo/exojs-examples check-ts:scripts",
    "typecheck:test": "tsx scripts/typecheck-tests.ts",
    "typecheck:test:update-baseline": "tsx scripts/typecheck-tests.ts --update-baseline",
    "typecheck:bench": "pnpm --filter @codexo/exojs-bench bench:setup && pnpm --filter @codexo/exojs-bench typecheck",
    "lint": "eslint --max-warnings=0 \"src/**/*.ts\" \"test/**/*.ts\" \"examples/**/*.ts\" \"scripts/**/*.{ts,mts,cts,mjs}\" \"packages/exojs-bench/competitors/*.ts\" \"*.config.ts\"",
    "lint:fix": "pnpm lint --fix",
    "lint:fast": "pnpm lint --cache --cache-location .cache/eslintcache",
    "lint:fast:fix": "pnpm lint:fast --fix",
    "lint:packages": "eslint --max-warnings=0 \"packages/exojs-*/src/**/*.{ts,tsx}\" \"packages/exojs-*/test/**/*.{ts,tsx}\" \"packages/create-exo-app/src/**/*.ts\"",
    "lint:site": "pnpm --filter @codexo/exojs-examples lint",
    "lint:packages:fix": "pnpm lint:packages --fix",
    "lint:all": "pnpm lint && pnpm lint:packages && pnpm lint:site",
    "lint:all:fix": "pnpm lint:fix && pnpm lint:packages:fix && pnpm lint:site --fix",
    "lint:source-hygiene": "tsx scripts/check-source-hygiene.ts",
    "lint:inline-source": "tsx scripts/check-inline-source.ts",
    "lint:file-symbols": "tsx scripts/check-file-symbol-naming.ts",
    "lint:config-paths": "tsx scripts/check-eslint-config-paths.ts",
    "lint:overrides:audit": "tsx scripts/audit-eslint-overrides.ts",
    "lint:js-files": "tsx scripts/check-javascript-files.ts",
    "lint:shaders": "tsx scripts/check-shader-sources.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project=exojs --project=exojs-build --project=exojs-particles --project=exojs-tilemap --project=exojs-tiled --project=exojs-physics --project=exojs-tilemap-physics --project=exojs-audio-fx --project=exojs-aseprite --project=exojs-ldtk --project=exojs-react --project=rendering-perf --project=rendering-alloc",
    "test:core": "vitest run --project=exojs",
    "test:coverage": "vitest run --coverage --project=exojs --project=exojs-build --project=exojs-particles --project=exojs-tilemap --project=exojs-tiled --project=exojs-physics --project=exojs-tilemap-physics --project=exojs-audio-fx --project=exojs-aseprite --project=exojs-ldtk --project=exojs-react --project=rendering-perf",
    "test:alloc": "vitest run --project=rendering-alloc",
    "test:watch": "vitest --project=exojs",
    "test:production-stripping": "vitest run --project=exojs test/build-defines/production-stripping.test.ts",
    "test:skips": "pnpm run test --reporter=default --reporter=junit --outputFile.junit=./test-results/unit.junit.xml && tsx scripts/check-skipped-tests.ts",
    "test:skips:check": "tsx scripts/check-skipped-tests.ts",
    "test:skips:update-baseline": "tsx scripts/check-skipped-tests.ts --update-baseline",
    "test:browser": "pnpm run test:browser:webgl && pnpm run test:browser:webgpu && pnpm run test:browser:webgl:firefox && pnpm run test:browser:webgpu:firefox && pnpm run test:browser:build",
    "test:browser:webgl": "vitest run --project=browser-webgl-chromium",
    "test:browser:webgl:chromium": "pnpm run test:browser:webgl",
    "test:browser:webgl:firefox": "vitest run --project=browser-webgl-firefox",
    "test:browser:webgpu": "vitest run --project=browser-webgpu",
    "test:browser:webgpu:chromium": "pnpm run test:browser:webgpu",
    "test:browser:webgpu:firefox": "vitest run --project=browser-webgpu-firefox",
    "test:browser:assets": "vitest run --project=browser-assets-chromium",
    "test:browser:audio": "vitest run --project=browser-audio-chromium",
    "test:browser:tilemap": "vitest run --project=browser-tilemap-chromium",
    "test:browser:build": "vitest run --project=browser-build-chromium",
    "test:parity": "tsx ./scripts/run-parity.ts --project=browser-webgpu test/rendering/parity",
    "test:parity:firefox": "tsx ./scripts/run-parity.ts --project=browser-webgpu-firefox test/rendering/parity",
    "test:parity:webkit": "tsx ./scripts/run-parity.ts --project=browser-parity-webkit",
    "test:parity:safari": "tsx ./scripts/run-parity.ts --project=browser-parity-safari",
    "webgpu:probe": "tsx scripts/webgpu-probe.ts",
    "bench": "vitest bench",
    "bench:run": "vitest bench --run",
    "site:install": "pnpm bootstrap",
    "site:build": "pnpm --filter @codexo/exojs-examples build",
    "site:build:api": "pnpm --filter @codexo/exojs-examples build:api",
    "test:examples:smoke": "pnpm --filter @codexo/exojs-examples examples:smoke",
    "perf:renderers": "tsx test/perf/rendering/run-sweep.ts full",
    "perf:renderers:quick": "tsx test/perf/rendering/run-sweep.ts quick",
    "perf:renderers:browser": "vitest run --project=browser-webgl-chromium webgl2-renderer-perf",
    "perf:renderers:alloc": "node --conditions=@codexo/exojs-source --import ./scripts/glsl-register.ts --import tsx/esm test/perf/rendering/run-allocation.ts",
    "perf:renderers:alloc:cell": "node --conditions=@codexo/exojs-source --import ./scripts/glsl-register.ts --import tsx/esm test/perf/rendering/run-allocation-cell.ts",
    "perf:renderers:cull-margin": "node --conditions=@codexo/exojs-source --import ./scripts/glsl-register.ts --import tsx/esm test/perf/rendering/run-cull-margin.ts",
    "perf:renderers:cull-margin:cell": "node --expose-gc --max-old-space-size=8192 --conditions=@codexo/exojs-source --import ./scripts/glsl-register.ts --import tsx/esm test/perf/rendering/run-cull-margin-cell.ts",
    "perf:renderers:bootstrap": "node --conditions=@codexo/exojs-source --import ./scripts/glsl-register.ts --import tsx/esm test/perf/rendering/run-bootstrap-allocation.ts",
    "perf:renderers:bootstrap:cell": "node --expose-gc --max-old-space-size=8192 --conditions=@codexo/exojs-source --import ./scripts/glsl-register.ts --import tsx/esm test/perf/rendering/run-bootstrap-cell.ts",
    "perf:bench:rendering": "node --conditions=@codexo/exojs-source --import ./scripts/glsl-register.ts --import tsx/esm test/perf/rendering-benchmark.ts",
    "perf:bench:audio": "node --conditions=@codexo/exojs-source --import ./scripts/glsl-register.ts --import tsx/esm test/perf/audio-benchmark.ts",
    "perf:bench:collision": "node --conditions=@codexo/exojs-source --import ./scripts/glsl-register.ts --import tsx/esm test/perf/collision-benchmark.ts",
    "perf:bench:scene-graph": "node --conditions=@codexo/exojs-source --import ./scripts/glsl-register.ts --import tsx/esm test/perf/scene-graph-benchmark.ts",
    "perf:bench:interaction": "node --conditions=@codexo/exojs-source --import ./scripts/glsl-register.ts --import tsx/esm test/perf/interaction-benchmark.ts",
    "perf:bench:collect-phase": "node --conditions=@codexo/exojs-source --import ./scripts/glsl-register.ts --import tsx/esm test/perf/collect-phase-benchmark.ts",
    "perf:bench:all": "pnpm perf:bench:rendering && pnpm perf:bench:audio && pnpm perf:bench:collision && pnpm perf:bench:scene-graph && pnpm perf:bench:interaction && pnpm perf:bench:collect-phase",
    "perf:smoke": "pnpm perf:bench:all && pnpm perf:profile",
    "bench:setup": "pnpm --filter @codexo/exojs-bench bench:setup",
    "perf:baseline": "pnpm --filter @codexo/exojs-bench bench",
    "perf:profile": "node --conditions=@codexo/exojs-source --import ./scripts/glsl-register.ts --import tsx/esm test/perf/profile-benchmark.ts",
    "perf:profile:gc": "node --expose-gc --conditions=@codexo/exojs-source --import ./scripts/glsl-register.ts --import tsx/esm test/perf/profile-benchmark.ts",
    "size": "size-limit",
    "size:summary": "tsx scripts/ci/bundle-size-summary.ts",
    "prepare": "husky",
    "perf:renderers:instance-cost": "node --expose-gc --max-old-space-size=8192 --conditions=@codexo/exojs-source --import ./scripts/glsl-register.ts --import tsx/esm test/perf/rendering/run-instance-cost.ts",
    "perf:webgpu:alloc": "tsx test/perf/webgpu/run-webgpu-allocation.ts",
    "perf:webgpu:timer": "pnpm --filter @codexo/exojs-bench timer"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/Exoridus/ExoJS",
  "bugs": {
    "url": "https://github.com/Exoridus/ExoJS/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Exoridus/ExoJS.git"
  },
  "size-limit": [
    {
      "path": "dist/exo.esm.js",
      "limit": "700 KB",
      "gzip": true
    },
    {
      "path": "dist/exo.iife.min.js",
      "limit": "320 KB",
      "gzip": true
    },
    {
      "path": "dist/exo.debug.esm.js",
      "limit": "5 KB",
      "gzip": true,
      "ignore": [
        "@codexo/exojs"
      ]
    }
  ],
  "devDependencies": {
    "@codecov/rollup-plugin": "^2.0.1",
    "@codexo/exojs-build": "workspace:*",
    "@codexo/exojs-config": "workspace:*",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@size-limit/preset-small-lib": "^13.0.3",
    "@types/css-font-loading-module": "0.0.14",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^26.4.0",
    "@vitest/browser": "^4.1.7",
    "@vitest/browser-playwright": "^4.1.7",
    "@vitest/browser-webdriverio": "^4.1.10",
    "@vitest/coverage-istanbul": "^4.1.7",
    "@webgpu/types": "^0.1.69",
    "esbuild": "^0.28.2",
    "eslint": "~10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-security": "^4.0.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unicorn": "^74.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.4.1",
    "playwright": "^1.62.1",
    "prettier": "3.9.6",
    "rimraf": "^6.1.3",
    "rolldown": "1.2.6",
    "rollup": "^4.63.1",
    "rollup-plugin-esbuild": "^6.2.1",
    "size-limit": "^13.0.3",
    "tslib": "^2.8.1",
    "tsx": "^4.23.12",
    "typescript": "~6.0.3",
    "typescript-eslint": "~8.68.0",
    "vitest": "^4.1.7"
  }
}
