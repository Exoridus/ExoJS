{
  "$schema": "https://json.schemastore.org/tsconfig",
  // Type-checks `test/**` — the root `tsconfig.json` includes `src/**` only, so
  // nothing ever compiled the test tree. Vitest does not typecheck and esbuild
  // only strips annotations, so a test could misuse an API and still pass
  // because the mock swallows the call.
  //
  // Deliberately looser than the engine program, because test code has
  // different economics:
  //   - `noUncheckedIndexedAccess` off: fixtures and captured mock-call tuples
  //     are indexed positionally everywhere, and re-proving each index would
  //     bury the findings this program exists to surface.
  //   - `noUnusedLocals` / `noUnusedParameters` off: partial mocks legitimately
  //     ignore arguments and keep unused fixture handles around.
  // `strict`, `strictNullChecks` and `noImplicitAny` stay ON — those are what
  // catch a half-wrong mock.
  //
  // `rootDir`/emit options are neutralised because this program never emits.
  //
  // Run through `pnpm typecheck:test`, which ratchets the remaining errors
  // per file against scripts/test-typecheck-baseline.json; a bare
  // `tsc -p tsconfig.test.json` reports the raw, unratcheted list.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "allowJs": true,
    "verbatimModuleSyntax": false,
    "isolatedModules": false,
    "ignoreDeprecations": "6.0",
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noUncheckedIndexedAccess": false,
    "types": ["vitest/globals", "node", "jsdom", "@webgpu/types", "css-font-loading-module"],
    // Resolve every workspace specifier to source, the same way
    // tsconfig.examples.json does for the example catalog. Without this the
    // program silently falls back to `dist/`, which makes the result depend on
    // whether the machine has built — green locally, red in CI.
    "customConditions": ["@codexo/exojs-source", "@codexo/exojs-particles-source"],
    "paths": {
      "@codexo/exojs": ["./src/index.ts"],
      "@codexo/exojs/extensions": ["./src/extensions/index.ts"],
      "@codexo/exojs/renderer-sdk": ["./src/renderer-sdk.ts"],
      "@codexo/exojs/debug": ["./src/debug/index.ts"],
      "@codexo/exojs-particles": ["./packages/exojs-particles/src/index.ts"],
      "@codexo/exojs-tilemap": ["./packages/exojs-tilemap/src/index.ts"],
      "@codexo/exojs-tiled": ["./packages/exojs-tiled/src/index.ts"],
      "@codexo/exojs-physics": ["./packages/exojs-physics/src/index.ts"],
      "@codexo/exojs-audio-fx": ["./packages/exojs-audio-fx/src/index.ts"],
      "@codexo/exojs-aseprite": ["./packages/exojs-aseprite/src/index.ts"],
      "@codexo/exojs-ldtk": ["./packages/exojs-ldtk/src/index.ts"],
      "@codexo/exojs-physics/debug": ["./packages/exojs-physics/src/debug/index.ts"]
    }
  },
  "include": ["test/**/*", "src/typings.d.ts", "test/typings.d.ts"],
  // `.tsx` type-test fixtures target a package this program cannot resolve
  // (react lives in the react package's own tree, and the JSX runtime comes
  // from its tsconfig). Checked here, every assertion in them would silently
  // widen to `any` and the negative cases would report as unused directives —
  // a gate that reads green precisely because it stopped checking. They have a
  // dedicated project instead; see `typecheck:type-tests`.
  "exclude": ["dist", "node_modules", "test/type-tests/**/*.tsx"]
}
