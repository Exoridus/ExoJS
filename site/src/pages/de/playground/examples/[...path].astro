---
import PlaygroundExamplePage from '../../../../components/pages/PlaygroundExamplePage.astro';
import { EXAMPLE_ALIASES } from '../../../../lib/example-aliases';
import { getRunnableExamples } from '../../../../lib/examples-catalog';

export const getStaticPaths = async () =>
  [...getRunnableExamples().map(entry => entry.path), ...Object.keys(EXAMPLE_ALIASES)].map(path => ({
    params: { path: path.replace(/\.js$/, '') },
  }));

const routePath = (Astro.params as Record<string, string | undefined>).path ?? '';
---

<PlaygroundExamplePage locale="de" path={`${routePath}.js`} />
