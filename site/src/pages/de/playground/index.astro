---
import Layout from '../../../layouts/Layout.astro';
import { ExampleBrowser } from '../../../components/ExampleBrowser';
---

<Layout title="ExoJS Playground">
    <!-- Skip-link target — light-DOM wrapper that's focusable so Skip-to-main-content
         actually lands on something keyboard-traversable. Focus then tabs into the
         shadow tree of <example-browser> as normal. -->
    <div class="playground-main">
        <p class="playground-tool-link">Verfügbare Bilder, Sounds oder Schriftarten ansehen? <a href={`${import.meta.env.BASE_URL}de/tools/asset-browser/`}>Asset Browser öffnen</a>.</p>
        <ExampleBrowser client:load baseUrl={import.meta.env.BASE_URL} locale="de" />
    </div>
</Layout>

<style>
    /* The playground fills the viewport under the header minus this row, so its
       height is fixed and shared with ExampleBrowser through --playground-offset. */
    .playground-main { --playground-offset: 2.25rem; }
    .playground-tool-link { box-sizing: border-box; height: var(--playground-offset); line-height: var(--playground-offset); margin: 0; padding: 0 1rem; overflow: hidden; white-space: nowrap; font-size: 0.82rem; color: var(--fg-muted); }
</style>
