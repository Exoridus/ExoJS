---
import PlaygroundExamplePage from '../../../../components/pages/PlaygroundExamplePage.astro';
import { EXAMPLE_ALIASES, EXAMPLE_TOOL_RELOCATIONS, resolveExampleToolRelocation } from '../../../../lib/example-aliases';
import { getAllExamples } from '../../../../lib/examples-catalog';
import { CURRENT_VERSION_ID } from '../../../../lib/versions';

export const getStaticPaths = async () =>
  [...getAllExamples().map(entry => entry.path), ...Object.keys(EXAMPLE_ALIASES), ...Object.keys(EXAMPLE_TOOL_RELOCATIONS)].map(path => ({
    params: { path: path.replace(/\.js$/, '') },
  }));

const routePath = (Astro.params as Record<string, string | undefined>).path ?? '';
const relocation = resolveExampleToolRelocation(CURRENT_VERSION_ID, `${routePath}.js`);
const toolHref = relocation === null ? null : `${import.meta.env.BASE_URL}en/${relocation}`;
---

{toolHref !== null ? (
  <html lang="en">
    <head>
      <meta http-equiv="refresh" content={`0;url=${toolHref}`} />
      <link rel="canonical" href={toolHref} />
    </head>
    <body>
      <a href={toolHref}>Open Asset Browser</a>
    </body>
  </html>
) : (
  <PlaygroundExamplePage locale="en" path={`${routePath}.js`} />
)}
