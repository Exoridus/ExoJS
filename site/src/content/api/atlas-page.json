{
  "title": "AtlasPage",
  "description": "A single texture page within a GlyphAtlas. Glyphs are packed into the page using a shelf-bin algorithm. In `'sdf'` mode the page owns a `DataTexture` (`r8`) populated by tiny-sdf output. In `'color'` mode a Canvas 2D context preserves full glyph colours for emoji.",
  "symbol": "AtlasPage",
  "kind": "interface",
  "subsystem": "rendering",
  "importPath": "@codexo/exojs",
