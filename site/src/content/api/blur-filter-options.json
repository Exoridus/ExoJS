              "kind": "punctuation"
            },
            {
              "text": ": ",
              "kind": "punctuation"
            },
            {
              "text": "number",
              "kind": "keyword"
            }
          ],
          "params": [],
          "returnType": null,
          "description": "Gaussian standard deviation in LOGICAL units - unchanged by the display's pixel ratio. The same quantity CSS blur() and Pixi's strength take, so a value carried over from either produces the same blur here. Default 2."
        }
