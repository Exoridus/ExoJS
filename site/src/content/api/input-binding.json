{
  "title": "InputBinding",
  "description": "One subscription to one or more input channels. Tracks active state, fires the onStart / onActive / onStop / onTrigger Signals each frame, and registers itself with whichever owner created it (typically an InputManager, Gamepad, or scene-bound proxy). Construct via the owner's `onStart` / `onActive` / `onStop` / `onTrigger` factory methods rather than `new InputBinding(...)` directly — the returned binding is caller-owned from that point on. Lifecycle: a binding lives until unbind is called, the owner disposes it, or — for scene-bound bindings — the scene unloads.",
  "symbol": "InputBinding",
  "kind": "class",
  "subsystem": "input",
  "importPath": "@codexo/exojs",
  "tier": "stable",
