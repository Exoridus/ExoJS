              "kind": "punctuation"
            },
            {
              "text": "boolean",
              "kind": "keyword"
            }
          ],
          "params": [],
          "returnType": null,
          "description": "true on the frame the aggregate value crossed back below the threshold. See pressed."
        },
        {
          "name": "value",
          "signature": "value: number",
