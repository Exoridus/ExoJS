            }
          ],
          "params": [],
          "returnType": null,
          "description": "Let the browser start a text selection from a drag on the canvas. Default false - a drag is normally a game gesture, and a stray selection highlight over the canvas is almost never wanted."
        },
        {
          "name": "dragThreshold",
          "signature": "dragThreshold?: number",
