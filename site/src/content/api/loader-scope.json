            {
              "text": "void",
              "kind": "keyword"
            }
          ],
          "params": [],
          "returnType": "void",
          "description": "Releases every claim this scope still holds and destroys any child scope it still has. Assets another scope also holds stay resident, and destroying an already-destroyed scope is a no-op."
