{
  "title": "LoaderScope",
  "description": "Owns asset claims for one lifetime. Owners share resident payloads without sharing release authority. Destroying a live parent releases its existing children; create child scopes only while the parent is live. This revision does not reject createScope() after parent destruction, and such a late child is not released by a repeated parent destroy(). Use a scene scope for scene assets and a child scope for shorter-lived levels, previews, or prefetch work. Direct Loader acquisitions instead belong to its application-lifetime scope.",
  "symbol": "LoaderScope",
  "kind": "class",
  "subsystem": "assets",
  "importPath": "@codexo/exojs",
  "tier": "stable",
  "memberCount": 24,
  "counts": {
    "constructors": 0,
    "methods": 17,
    "properties": 3,
    "events": 4
  },
