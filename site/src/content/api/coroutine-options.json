              "kind": "punctuation"
            },
            {
              "text": ": ",
              "kind": "punctuation"
            },
            {
              "text": "DestroyScope",
              "kind": "type"
            }
          ],
          "params": [],
          "returnType": null,
          "description": "Scope that owns the coroutine for as long as it runs: the system tracks it there on CoroutineSystem.queue and untracks it again on settlement, so a scene or screen destroyed mid-run cancels it without collecting every coroutine it ever started."
        },
        {
