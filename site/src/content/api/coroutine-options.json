              "text": "number",
              "kind": "keyword"
            }
          ],
          "params": [],
          "returnType": null,
          "description": "First claim on the frame's slice; higher runs earlier. Once everything at the highest priority present has been stepped, whatever is left of the slice goes to the next priority down - priority decides order, not exclusive access. Coroutines of equal priority take turns across frames. Default 0, writable afterwards through Coroutine.priority."
        },
        {
          "name": "scope",
          "signature": "scope?: DestroyScope",
          "signatureTokens": [
            {
              "text": "scope",
              "kind": "name"
