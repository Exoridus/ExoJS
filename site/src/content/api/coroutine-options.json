          "returnType": null,
          "description": "Label for diagnostics: it appears in the development warning about a step that overruns its slice, and makes CoroutineSystem's read surface legible to a debug overlay. Not a lookup key - the system exposes no retrieval by name, and Coroutine remains the handle."
        },
        {
          "name": "priority",
          "signature": "priority?: number",
          "signatureTokens": [
            {
              "text": "priority",
