        {
          "name": "pixelRatio",
          "signature": "pixelRatio?: number",
          "signatureTokens": [
            {
              "text": "pixelRatio",
              "kind": "name"
            },
            {
              "text": "?",
              "kind": "punctuation"
            },
            {
              "text": ": ",
              "kind": "punctuation"
