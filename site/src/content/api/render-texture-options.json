            },
            {
              "text": "boolean",
              "kind": "keyword"
            }
          ],
          "params": [],
          "returnType": null,
          "description": "Whether the source content is stored bottom-up. Resolved when UVs are packed rather than by flipping pixels at upload time, so it costs nothing per frame but does invalidate geometry recorded against the old value."
        },
        {
