      "paragraphs": [
        "Handle for work handed to a JobScheduler. Poll Job.status and Job.result from frame code, or await Job.done from async code; both see the same settlement. Cancelling (or destroying, which is the same) stops the generator at its current `yield` and settles the job as `cancelled`."
      ],
      "importLine": "import { Job } from '@codexo/exojs'",
