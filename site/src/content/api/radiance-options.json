          "params": [],
          "returnType": null,
          "description": "The finest cascade's ray length, in probe spacings. Each level covers four times what the level below it did, so this sets where the chain starts. Defaults to 1."
        },
        {
          "name": "probeSpacing",
          "signature": "probeSpacing?: number",
          "signatureTokens": [
