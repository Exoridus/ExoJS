            }
          ],
          "params": [],
          "returnType": null,
          "description": "Tap cap for the blur, see BlurFilterOptions.quality. Derived when omitted."
        },
        {
          "name": "strength",
          "signature": "strength?: number",
          "signatureTokens": [
