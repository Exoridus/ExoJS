            }
          ],
          "params": [],
          "returnType": null,
          "description": "Gaussian standard deviation of the glow in LOGICAL units - the same quantity BlurFilterOptions.strength takes, unchanged by the display's pixel ratio. Default 8."
        },
        {
          "name": "threshold",
          "signature": "threshold?: number",
          "signatureTokens": [
            {
              "text": "threshold",
              "kind": "name"
            },
            {
              "text": "?",
              "kind": "punctuation"
            },
            {
              "text": ": ",
              "kind": "punctuation"
            },
            {
              "text": "number",
              "kind": "keyword"
            }
          ],
          "params": [],
          "returnType": null,
          "description": "Luminance a pixel needs before it glows, in 0..1. Rec. 709 luma of the premultiplied input, so a half-transparent white glows like an opaque grey. The knee is soft, which puts this value in the MIDDLE of the transition rather than at a hard cut: light a little below it still contributes a little glow, and a gradient crossing it shows no edge. Default 0.8."
        }
