          "params": [],
          "returnType": null,
          "description": "Alpha multiplier at the oldest end of a trail, interpolated from 1 at the particle itself. A trail carries one particle's tint from end to end, so this is what separates head from tail; 1 draws it as a solid band."
        },
        {
          "name": "interval",
          "signature": "interval?: number",
          "signatureTokens": [
            {
              "text": "interval",
