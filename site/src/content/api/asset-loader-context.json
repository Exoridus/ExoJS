            {
              "text": "LoaderScope",
              "kind": "type"
            }
          ],
          "params": [],
          "returnType": null,
          "description": "The claim scope that owns whatever sub-assets this handler loads. It lives exactly as long as the asset being built: when that asset is released by its last owner, everything loaded through this scope is released with it - unless another owner still holds it independently."
        },
        {
          "name": "signal",
