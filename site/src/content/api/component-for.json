          ],
          "params": [],
          "returnType": "void",
          "description": "End the component for good: disable it if active, detach it from its node if attached, then run onDestroy. Idempotent. Destroying a node destroys every component still attached to it. Every step runs even when a hook throws; the first error is rethrown afterwards."
        },
        {
          "name": "markChanged",
          "signature": "markChanged(): void",
          "signatureTokens": [
            {
              "text": "markChanged",
              "kind": "name"
            },
            {
