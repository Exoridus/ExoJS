            },
            {
              "text": ": ",
              "kind": "punctuation"
            },
            {
              "text": "void",
              "kind": "keyword"
            }
          ],
          "params": [],
          "returnType": "void",
          "description": "Report that this component's state changed, so every change observer (ComponentQuery.changed) over a query that matches it lists its node once in its next pass. Nothing is tracked automatically: call it after the writes other code should react to. Cheap and idempotent within a pass: it stores one number, whatever the number of observers. A component outside any scene has nothing to report to; joining a scene counts as a change on its own."
        }
      ],
