{
  "title": "CompressedTexture",
  "description": "A Texture constructed directly from a compressed payload. Convenience only: a compressed payload is something a plain `Texture` can carry, so anything accepting a `Texture` accepts one of these, and a texture loaded from a container arrives as a plain `Texture` with Texture.compressed set. Code that needs to tell the difference reads that property rather than testing the class.",
  "symbol": "CompressedTexture",
  "kind": "class",
  "subsystem": "rendering",
  "importPath": "@codexo/exojs",
  "tier": "stable",
