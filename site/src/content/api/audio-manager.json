{
  "title": "AudioManager",
  "description": "Per-Application owner of the audio mix: three pre-configured AudioBus instances (`master` ← `music` + `sound`), a single AudioListener for spatial audio, and a registry of any extra busses the user constructs. The `AudioContext` is shared process-wide, but each Application owns its own bus subtree, so multiple Applications mix independently. Access it via `app.audio`. Drives the per-frame `_tick()` on the listener and every spatial voice, and propagates visibility-driven mute when AudioManager.muteOnHidden is enabled.",
  "symbol": "AudioManager",
  "kind": "class",
  "subsystem": "audio",
  "importPath": "@codexo/exojs",
  "tier": "stable",
