---
import Layout from '../../layouts/Layout.astro';

interface Props {
  locale: 'en' | 'de';
  /** Key `preview.html` resolves to the tool's example module. */
  tool: 'asset-browser' | 'widget-lab';
  title: string;
  description: string;
  /** Example source path under `examples/`. */
  source: string;
  /** Page query parameters handed on to the tool. */
  forward?: readonly string[];
}
const { locale, tool, title, description, source, forward = [] } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<Layout title={`${title} - ExoJS`} description={description}>
  <section class="tool" aria-label={title}>
    <nav aria-label="Playground tools">
      <a href={`${base + locale}/playground/`}>Playground</a>
      <strong>{title}</strong>
      <a href={`${base}examples/${source}`} target="_blank" rel="noopener noreferrer">
        Tool source
      </a>
    </nav>
    <div class="workspace">
      <iframe
        title={`ExoJS ${title}`}
        data-tool-frame
        data-preview={`${base}preview.html?tool=${tool}`}
        data-forward={forward.join(',')}
        allow="autoplay; fullscreen"
      ></iframe>
    </div>
  </section>
</Layout>
<script>
  const frame = document.querySelector<HTMLIFrameElement>('[data-tool-frame]');
  if (frame?.dataset.preview) {
    const url = new URL(frame.dataset.preview, window.location.origin);
    const page = new URLSearchParams(window.location.search);
    for (const name of (frame.dataset.forward ?? '').split(',').filter(Boolean)) {
      const value = page.get(name);
      if (value) {
        url.searchParams.set(name, value);
      }
    }
    frame.src = url.href;
  }
</script>
<style>
  .tool {
    display: flex;
    flex-direction: column;
    height: calc(100dvh - 62px);
    min-height: 520px;
  }

  nav {
    display: flex;
    align-items: center;
    gap: var(--s-4);
    flex: 0 0 auto;
    padding: var(--s-2) var(--s-4);
    border-bottom: 1px solid var(--line-soft);
    font-size: var(--text-sm);
  }

  nav a:last-child {
    margin-left: auto;
  }

  .workspace {
    flex: 1 1 auto;
    min-height: 0;
    overflow: auto;
  }

  iframe {
    display: block;
    width: 100%;
    min-width: 960px;
    height: 100%;
    border: 0;
  }

  @media (width <= 760px) {
    .tool {
      height: calc(100dvh - 58px);
    }
  }
</style>
