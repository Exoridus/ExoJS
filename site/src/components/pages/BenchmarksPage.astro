---
/**
 * BenchmarksPage - the published cross-library measurements.
 *
 * The page is generated at build time from the machine profiles under
 * `packages/exojs-bench/results/` and from nothing else, so it cannot drift from
 * the harness: a re-measurement rewrites the headline paragraph, the tables and
 * the provenance together. Losses are published on the same terms as wins, and
 * the rows the harness left out of a comparison are shown with their reasons.
 *
 * When the directory holds no profile - a fresh clone, or the state a release
 * branch sits in before its reference run - the measured sections disappear and
 * the methodology, reproduction and fairness sections stay, because those are
 * what a reader can act on when there is nothing to read yet.
 */

import BenchProfileReport from '../BenchProfileReport.astro';
import DocsLayout from '../../layouts/DocsLayout.astro';
import EnglishFallbackNotice from '../EnglishFallbackNotice.astro';
import { appInfo } from '../../lib/app-info';
import { formatDay, furtherProfiles, headlineFindings, olderThanReference, referenceProfile } from '../../lib/bench-profiles';

interface Props {
    locale: 'en' | 'de';
}

const { locale } = Astro.props;
const findings = referenceProfile === undefined ? [] : headlineFindings(referenceProfile);

/** The word next to a headline sentence, so a lead and a loss are labelled rather than coloured into a ranking. */
const TONE_LABELS = { scope: 'scope', lead: 'lead', level: 'level', loss: 'loss' } as const;
---

<DocsLayout title="ExoJS benchmarks" description="Measured comparisons between ExoJS and other 2D rendering and physics libraries.">
    <aside slot="rail" class="toc" aria-label="Benchmarks table of contents">
        <h6>On this page</h6>
        <ul>
            <li><a href="#findings" data-active="true">Headline findings</a></li>
            {referenceProfile !== undefined && <li><a href="#reference">Reference profile</a></li>}
            {furtherProfiles.length > 0 && <li><a href="#further">Further machines</a></li>}
            <li><a href="#methodology">Methodology</a></li>
            <li><a href="#reproduce">Reproduce</a></li>
            <li><a href="#fairness">Fairness</a></li>
        </ul>
    </aside>

    <div class="prose bench-prose" data-pagefind-body={locale === 'en' ? true : undefined}>
        {locale === 'de' && <EnglishFallbackNotice />}

        <header class="bench-head">
            <h1>Benchmarks</h1>
            <p>
                How ExoJS compares against Pixi, Phaser and Excalibur for rendering, and against matter.js, planck and Rapier for physics. The ratios are
                the statement and the milliseconds are the evidence behind them. Every number on this page was written by the benchmark harness into a
                signed profile file in the repository; none of it is typed by hand, and every cell where ExoJS trails is published exactly like the ones
                where it leads.
            </p>
        </header>

        <section id="findings">
            <h2>Headline findings</h2>
            {findings.length === 0 ? (
                <p class="empty">
                    No measurements are published yet. The reference run is taken on one machine after a release is tagged and lands as a single profile
                    file in the repository; until then there is nothing here to read. The methodology, the reproduction steps and the fairness terms below
                    already apply.
                </p>
            ) : (
                <ul class="findings">
                    {findings.map(finding => (
                        <li class:list={['finding', finding.tone]}>
                            <span class="tone">{TONE_LABELS[finding.tone]}</span>
                            <p>{finding.text}</p>
                        </li>
                    ))}
                </ul>
            )}
        </section>

        {referenceProfile !== undefined && (
            <section id="reference">
                <h2>Reference profile</h2>
                <p>
                    One machine, measured after the release was tagged, with no other load on it. A re-measurement of the same machine overwrites this
                    profile; a different machine can only ever arrive as a new file.
                </p>
                <BenchProfileReport document={referenceProfile} headingLevel={3} />
            </section>
        )}

        {furtherProfiles.length > 0 && (
            <section id="further">
                <h2>Further machines</h2>
                <p>
                    Profiles contributed for other hardware, newest engine version first. They answer a different question from the reference run: whether
                    the ratios hold on another GPU, another driver stack and another JavaScript engine.
                </p>
                {furtherProfiles.map(document => {
                    const newer = olderThanReference(document);

                    return (
                        <details class="machine">
                            <summary>
                                <span class="machine-name">
                                    {document.profile.gpu} / {document.profile.os} / {document.profile.browser}
                                </span>
                                <span class="machine-meta">
                                    ExoJS {document.profile.engineVersion}, measured {formatDay(document.profile.measuredAt)}
                                </span>
                            </summary>
                            {newer !== null && (
                                <p class="stale">
                                    Measured with ExoJS {document.profile.engineVersion}; the newest published profile is {newer}. Compare it against the
                                    reference profile with that in mind.
                                </p>
                            )}
                            <BenchProfileReport document={document} headingLevel={3} showTitle={false} />
                        </details>
                    );
                })}
            </section>
        )}

        <section id="methodology">
            <h2>Methodology</h2>
            <ul class="method">
                <li>Every published number is a <strong>median</strong> over the timed window of one cell, never a mean and never an aggregate across archetypes.</li>
                <li>
                    A ratio between <strong>0.8 and 1.2</strong> is reported as <code>level</code>: inside that band the difference is not distinguishable
                    from machine mood.
                </li>
                <li>
                    A gap of <strong>5x or more</strong> is reported as <em>leads clearly</em> rather than <em>leads</em>. Below that factor a driver state
                    or an unlucky window could still explain the result; at or above it, the difference is attributable to how the two libraries are built.
                </li>
                <li>
                    Each row names the <strong>mechanism</strong> behind its difference, drawn from structural counters the harness collects - draw calls,
                    texture binds, buffer uploads, solved contacts. A row whose difference could not be evidenced that way is not published as a
                    comparison; it appears among the omissions instead.
                </li>
                <li>One profile describes <strong>one machine</strong>. Numbers from different machines are never mixed into one table or averaged together.</li>
                <li>
                    Phaser renders through a <strong>WebGL1</strong> context, so its rows sit in their own block, compare CPU time only, and carry no
                    mechanism - the structural probe cannot attach to that context to say whether the backend generation or the engine caused the gap.
                </li>
                <li>
                    Rapier is a <strong>Rust/WASM reference ceiling</strong>, not a pure-JS peer. It measures what leaving JavaScript buys; matter.js and
                    planck are the peers ExoJS is compared against.
                </li>
                <li>Culling is configured to match across arms, so no arm wins a row by drawing less of the same scene.</li>
                <li>
                    A table uses <strong>one node or body count</strong> for all of its rows, chosen from the archetype ladders before any timing is read,
                    so the count cannot be picked per row to suit the outcome. An arm that produced no comparable cell at that count - because it sits the
                    archetype out, or because it exceeded the runaway step budget - is shown as <em>not comparable</em> rather than omitted.
                </li>
            </ul>
        </section>

        <section id="reproduce">
            <h2>Reproduce</h2>
            <p>The harness is in the repository, and so are the adapters. Running it yourself produces a profile in the same format as the ones above.</p>
            <pre><code>git clone {appInfo.repositoryUrl}
cd exojs
pnpm bootstrap
pnpm bench
pnpm bench:compare --profile</code></pre>
            <p>
                <code>pnpm bootstrap</code> installs the competitor libraries alongside the workspace, <code>pnpm bench</code> runs both matrices, and
                <code>pnpm bench:compare --profile</code> writes a profile named after your machine into
                <code>packages/exojs-bench/results/</code>. Measure on an otherwise idle machine: these are wall-clock comparisons and background load
                moves them.
            </p>
            <p>
                A profile for a machine that is not published yet is welcome as a pull request containing that one file. Nothing else needs to change - this
                page picks it up from the directory.
            </p>
        </section>

        <section id="fairness">
            <h2>Fairness</h2>
            <p>
                The adapter for every competitor is in the repository next to the ExoJS one, and each is configured at that library's own defaults with the
                deviations disclosed in the run's caveats. If a maintainer of one of these libraries thinks an adapter misrepresents it, an issue about that
                adapter is the right place to say so, and a fix changes the published numbers the next time the harness runs.
            </p>
            <p>
                Nothing here is aggregated into a score and nothing is declared an overall winner. Every cell where ExoJS trails is published with the same
                weight as one where it leads, with the same mechanism evidence attached, and the rows the harness could not compare are listed with the
                reason it could not.
            </p>
        </section>
    </div>
</DocsLayout>

<style>
    .bench-prose {
        max-width: none;
    }

    .bench-head {
        margin-bottom: var(--s-6);
    }

    .bench-head h1 {
        margin: 0 0 var(--s-3);
    }

    .bench-head p {
        margin: 0;
        max-width: 68ch;
        color: var(--fg-muted);
        line-height: 1.65;
    }

    .empty {
        margin: 0;
        padding: var(--s-4);
        border: 1px solid var(--line-soft);
        border-left: 3px solid var(--accent);
        border-radius: var(--r-3);
        background: var(--bg-elevated);
        color: var(--fg-muted);
        max-width: 68ch;
    }

    .findings {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: var(--s-3);
    }

    /*
     * A lead and a loss get the same box, the same type and the same border
     * weight; the tone chip only names which one it is. Styling a win louder
     * than a loss would make the paragraph an argument rather than a report.
     */
    .finding {
        display: grid;
        grid-template-columns: 5.5rem minmax(0, 1fr);
        gap: var(--s-3);
        align-items: start;
        padding: var(--s-3) var(--s-4);
        border: 1px solid var(--line-soft);
        border-radius: var(--r-3);
        background: var(--bg-elevated);
    }

    .finding p {
        margin: 0;
        line-height: 1.6;
    }

    .tone {
        display: inline-block;
        padding: 0.15rem 0.5rem;
        border: 1px solid currentcolor;
        border-radius: var(--r-pill);
        font-family: var(--f-mono);
        font-size: 0.7rem;
        font-weight: 600;
        text-align: center;
        letter-spacing: 0.04em;
    }

    .finding.scope .tone {
        color: var(--fg-faint);
    }

    .finding.lead .tone {
        color: var(--sky);
    }

    .finding.loss .tone {
        color: var(--violet);
    }

    .finding.level .tone {
        color: var(--fg-muted);
    }

    .machine {
        margin-top: var(--s-4);
        border: 1px solid var(--line-soft);
        border-radius: var(--r-3);
        padding: var(--s-3) var(--s-4);
    }

    .machine summary {
        cursor: pointer;
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: var(--s-3);
    }

    .machine-name {
        font-weight: 600;
    }

    .machine-meta {
        color: var(--fg-faint);
        font-family: var(--f-mono);
        font-size: 0.75rem;
    }

    .stale {
        margin: var(--s-3) 0 0;
        padding: var(--s-2) var(--s-3);
        border-left: 3px solid var(--amber);
        color: var(--fg-muted);
        font-size: 0.85rem;
    }

    .method {
        margin: 0;
        padding-left: 1.15rem;
        max-width: 74ch;
        color: var(--fg-muted);
        line-height: 1.6;
    }

    .method li {
        margin-bottom: 0.5rem;
    }

    .method strong {
        color: var(--fg);
    }

    #reproduce pre {
        overflow-x: auto;
        max-width: 100%;
    }

    #reproduce p,
    #fairness p {
        max-width: 72ch;
        color: var(--fg-muted);
        line-height: 1.65;
    }

    @media (max-width: 760px) {
        .finding {
            grid-template-columns: 1fr;
            gap: var(--s-2);
        }

        .tone {
            justify-self: start;
        }
    }
</style>
