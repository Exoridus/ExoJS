---
/**
 * BenchmarksPage - the published cross-library measurements, rendering and
 * physics on one page of scenario cards.
 *
 * The page is generated at build time from the machine profiles under
 * `packages/exojs-bench/results/` and from nothing else, so it cannot drift from
 * the harness: a re-measurement rewrites the cards and the provenance together.
 * Losses are published on the same terms as wins, nothing is aggregated into a
 * score or an overall winner, and which scenarios open each section is fixed in
 * `bench-cards.ts` before any run happens, so the top of the page cannot become
 * a selection of whatever ExoJS won.
 *
 * The page carries cards and nothing else. Every row's own terms are one
 * disclosure inside that row's card, and the full per-row report, the
 * methodology and the raw profiles are their own pages: carrying them here made
 * a reader scroll past several screens of prose that say the same thing
 * whichever card raised the question.
 *
 * The page's axis is the BROWSER, not the machine. Switching machines changes
 * the CPU, the GPU, the operating system, the driver stack and the browser
 * engine at once, which is not an A/B of anything a reader can name; the
 * browser names one dimension, and it is the one a reader shipping a web game
 * chooses between.
 *
 * It is still not a browser benchmark, because each browser is currently
 * measured on its own machine. So these are presented as separate reference
 * profiles, each printing the machine it was measured on, and the page never
 * invites a reader to divide one browser's figures by another's. Profiles are
 * picked and never stacked: two of them share no comparison, so a second one
 * appended under the first would read as more evidence about the first.
 */

import BenchResultCard from '../BenchResultCard.astro';
import BenchLocalProbe from '../BenchLocalProbe.astro';
import DocsLayout from '../../layouts/DocsLayout.astro';
import EnglishFallbackNotice from '../EnglishFallbackNotice.astro';
import { appInfo } from '../../lib/app-info';
import { PHYSICS_HEADLINE_SCENARIOS, physicsCards, RENDERING_HEADLINE_SCENARIOS, renderingCards, selectCards } from '../../lib/bench-cards';
import {
    BACKEND_LABELS,
    browserLabel,
    type BrowserProfiles,
    deviceLabel,
    formatDay,
    platformName,
    profilesByBrowser,
    type ProfileBackendName,
} from '../../lib/bench-profiles';

interface Props {
    locale: 'en' | 'de';
}

const { locale } = Astro.props;
const base = import.meta.env.BASE_URL;

/**
 * Runs a reference profile is built from. A published profile states the number
 * it was actually built from; until one exists the page can only quote the
 * count its own reproduction steps prescribe.
 */
const REPRODUCTION_RUNS = 3;

const backends: readonly ProfileBackendName[] = ['webgl2', 'webgpu'];

/** Everything one browser's reference profile contributes to the page. */
const viewOf = (group: BrowserProfiles) => ({
    browser: group.browser,
    document: group.reference,
    others: group.others,
    rendering: backends
        .map(backend => ({ backend, ...selectCards(renderingCards(group.reference, backend), RENDERING_HEADLINE_SCENARIOS, 6) }))
        .filter(entry => entry.headline.length > 0),
    physics: selectCards(physicsCards(group.reference), PHYSICS_HEADLINE_SCENARIOS, 4),
});

const browsers = profilesByBrowser.map(viewOf);
const leading = browsers[0];
---

<DocsLayout title="ExoJS benchmarks" description="Measured comparisons between ExoJS and other 2D rendering and physics libraries." variant="wide">
    <div class="prose bench-prose" data-pagefind-body={locale === 'en' ? true : undefined}>
        {locale === 'de' && <EnglishFallbackNotice />}

        <header class="bench-head">
            <h1>Benchmarks</h1>
            <p class="lede">Rendering and physics, compared.</p>
        </header>

        {leading === undefined ? (
            <p class="empty">
                No measurements are published yet. The reference measurement is {REPRODUCTION_RUNS} separate runs on one machine after a release is tagged,
                pooled into a single profile file in the repository; until then there is nothing here to read.{' '}
                <a href={`${base}${locale}/benchmarks/methodology/`}>The terms they will be published under</a> already apply.
            </p>
        ) : (
            <>
                <div class="profile-head">
                    {/* Offered only where a second browser has a published profile: one choice is not a choice. */}
                    {browsers.length > 1 && (
                        <div class="browsers" role="group" aria-label="Reference profile">
                            {browsers.map((entry, index) => (
                                <button type="button" class="browser" data-browser={entry.browser} aria-pressed={index === 0 ? 'true' : 'false'}>
                                    {browserLabel(entry.browser)}
                                </button>
                            ))}
                        </div>
                    )}

                    {browsers.map((entry, index) => {
                        const { profile } = entry.document;

                        return (
                            <p class="stamp" data-browser={entry.browser} hidden={index !== 0}>
                                {/*
                                  * The machine is provenance, not a mode. It is printed beside every
                                  * set of figures because the browsers are measured on different
                                  * machines, so one browser's numbers divided by another's would be
                                  * a hardware ratio wearing a browser's name.
                                  */}
                                <b>{deviceLabel(profile)}</b>
                                <span>{platformName(profile)}</span>
                                <span>ExoJS {profile.engineVersion}</span>
                                <span>measured {formatDay(profile.measuredAt)}</span>
                                {/* Stated once, here, rather than again inside the opening sentence: it is a fact about the run, not about the result. */}
                                <span>median of {profile.runs} pooled runs</span>
                                {entry.others.length > 0 && (
                                    <a href={`${base}${locale}/benchmarks/full/`}>
                                        {entry.others.length} further {entry.others.length === 1 ? 'machine' : 'machines'} in this browser
                                    </a>
                                )}
                            </p>
                        );
                    })}
                </div>

                {browsers.map((entry, index) => (
                    <div class="browser-panel" data-browser={entry.browser} hidden={index !== 0}>
                        <section id={index === 0 ? 'rendering' : undefined} class="domain">
                            <div class="domain-head">
                                <div class="domain-title">
                                    <h2>Rendering</h2>
                                    <p class="unit">CPU time per frame · Lower is better</p>
                                </div>
                                {entry.rendering.length > 1 && (
                                    <div class="backends" role="group" aria-label="Rendering backend">
                                        {entry.rendering.map((block, position) => (
                                            <button
                                                type="button"
                                                class="backend"
                                                data-backend={block.backend}
                                                aria-pressed={position === 0 ? 'true' : 'false'}
                                            >
                                                {BACKEND_LABELS[block.backend]}
                                            </button>
                                        ))}
                                    </div>
                                )}
                            </div>

                            {entry.rendering.length === 0 ? (
                                <p class="empty">This machine published no rendering measurement.</p>
                            ) : (
                                entry.rendering.map((block, position) => (
                                    <div class="backend-panel" data-backend={block.backend} hidden={position !== 0}>
                                        <div class="cards">
                                            {block.headline.map(card => (
                                                <BenchResultCard card={card} domain="rendering" />
                                            ))}
                                        </div>

                                        {block.rest.length > 0 && (
                                            <details class="more">
                                                <summary>All rendering tests ({block.rest.length} more)</summary>
                                                <div class="cards">
                                                    {block.rest.map(card => (
                                                        <BenchResultCard card={card} domain="rendering" />
                                                    ))}
                                                </div>
                                            </details>
                                        )}
                                    </div>
                                ))
                            )}
                        </section>

                        <section id={index === 0 ? 'physics' : undefined} class="domain">
                            <div class="domain-head">
                                <div class="domain-title">
                                    <h2>Physics</h2>
                                    <p class="unit">CPU time per step · Lower is better</p>
                                </div>
                            </div>

                            {entry.physics.headline.length === 0 ? (
                                <p class="empty">This machine published no physics measurement.</p>
                            ) : (
                                <>
                                    <div class="cards">
                                        {entry.physics.headline.map(card => (
                                            <BenchResultCard card={card} domain="physics" />
                                        ))}
                                    </div>

                                    {entry.physics.rest.length > 0 && (
                                        <details class="more">
                                            <summary>All physics tests ({entry.physics.rest.length} more)</summary>
                                            <div class="cards">
                                                {entry.physics.rest.map(card => (
                                                    <BenchResultCard card={card} domain="physics" />
                                                ))}
                                            </div>
                                        </details>
                                    )}
                                </>
                            )}
                        </section>
                    </div>
                ))}

                {/* Four destinations and no explanatory paragraphs: what each one is is what its name says. */}
                <nav class="tools" aria-label="Benchmark data">
                    <a href={`${base}${locale}/benchmarks/full/`}>Full results</a>
                    <a href={`${base}${locale}/benchmarks/methodology/`}>Methodology</a>
                    <a href="#run-locally">Run locally</a>
                    <a href={`${appInfo.repositoryUrl}/tree/main/packages/exojs-bench/results`}>JSON</a>
                </nav>

                <BenchLocalProbe />
            </>
        )}
    </div>
</DocsLayout>

<script>
    /**
     * The reference profile and the backend choice both belong to the reader and
     * neither is derived from which one won more rows. Without JavaScript the
     * first panel of each is the one that is not `hidden`, so the page still
     * shows measured cards of one profile rather than an empty frame.
     *
     * A profile's panel is switched together with the stamp that names the
     * machine it was measured on: the numbers and their provenance are one
     * statement, and showing one profile's cards under another's stamp is the
     * single mistake this control can make.
     */
    const select = (buttons: NodeListOf<HTMLButtonElement>, panels: NodeListOf<HTMLElement>, key: 'browser' | 'backend', scope?: HTMLElement): void => {
        for (const button of buttons) {
            button.addEventListener('click', () => {
                for (const other of buttons) {
                    other.setAttribute('aria-pressed', String(other === button));
                }

                for (const panel of panels) {
                    if (scope === undefined || scope.contains(panel)) panel.hidden = panel.dataset[key] !== button.dataset[key];
                }
            });
        }
    };

    select(
        document.querySelectorAll<HTMLButtonElement>('.browsers .browser'),
        document.querySelectorAll<HTMLElement>('.browser-panel[data-browser], .stamp[data-browser]'),
        'browser',
    );

    // Scoped per profile: each panel carries its own backend controls, and a
    // click in one must not reveal the other profile's hidden panels.
    for (const panel of document.querySelectorAll<HTMLElement>('.browser-panel')) {
        select(panel.querySelectorAll<HTMLButtonElement>('.backend'), panel.querySelectorAll<HTMLElement>('.backend-panel'), 'backend', panel);
    }
</script>

<style>
    .bench-prose {
        max-width: none;
    }

    /* The docs reading measure belongs to prose pages; here it would wrap short notes beside full-width cards. */
    .bench-prose :where(p, li) {
        max-width: none;
    }

    .bench-head {
        margin-bottom: var(--s-4);
    }

    .bench-head h1 {
        margin: 0 0 var(--s-2);
    }

    .lede {
        margin: 0;
        color: var(--fg-muted);
        line-height: 1.6;
    }

    .profile-head {
        display: flex;
        flex-direction: column;
        gap: var(--s-3);
        margin-top: var(--s-4);
    }

    .browsers {
        display: flex;
        flex-wrap: wrap;
        gap: 0.3rem;
    }

    .browsers .browser {
        font: inherit;
        font-size: 0.85rem;
        padding: 0.3rem 0.8rem;
        border-radius: 999px;
        border: 1px solid var(--border);
        background: transparent;
        color: var(--fg-muted);
        cursor: pointer;
    }

    /* Weight and a filled ground as well as hue, so the selected profile is legible without separating the two colours. */
    .browsers .browser[aria-pressed='true'] {
        border-color: var(--accent);
        background: color-mix(in srgb, var(--accent) 14%, transparent);
        color: var(--fg);
        font-weight: 650;
    }

    /* A flex box outranks the user-agent rule the `hidden` attribute relies on, so the stamp of an unselected machine would stay on screen under the selected machine's own. */
    .stamp[hidden] {
        display: none;
    }

    .stamp {
        display: flex;
        flex-wrap: wrap;
        gap: 0.15rem var(--s-4);
        margin: 0 !important;
        font-family: var(--f-mono);
        font-size: 0.74rem;
        color: var(--fg-faint);
    }

    .stamp b {
        font-weight: 600;
        color: var(--fg-muted);
    }

    .stamp a {
        color: var(--fg-muted);
    }

    .empty {
        margin: 0;
        padding: var(--s-4);
        border: 1px solid var(--line-soft);
        border-left: 3px solid var(--accent);
        border-radius: var(--r-3);
        background: var(--bg-elevated);
        color: var(--fg-muted);
    }

    .domain {
        margin-top: var(--s-6);
    }

    .domain-head {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        justify-content: space-between;
        gap: var(--s-3);
        margin-bottom: var(--s-4);
    }

    .domain-title {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: var(--s-3);
    }

    .domain-title h2 {
        margin: 0;
    }

    .unit {
        margin: 0 !important;
        color: var(--fg-muted);
        font-size: 0.85rem;
    }

    .backends {
        display: flex;
        gap: 0.3rem;
    }

    .backend {
        font: inherit;
        font-size: 0.8rem;
        padding: 0.25rem 0.7rem;
        border-radius: 999px;
        border: 1px solid var(--border);
        background: transparent;
        color: var(--fg-muted);
        cursor: pointer;
    }

    .backend[aria-pressed='true'] {
        border-color: var(--accent);
        background: color-mix(in srgb, var(--accent) 14%, transparent);
        color: var(--fg);
        font-weight: 650;
    }

    /* Two per row on desktop: a card is a comparison to read, not a tile to scan,
       and a third column would shrink the bars past the point of being readable. */
    .cards {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        /* Each card is as tall as its own content: a row stretched to its tallest neighbour left a band of empty card under every shorter one. */
        align-items: start;
        gap: var(--s-4);
    }

    .more {
        margin-top: var(--s-4);
    }

    .more > summary {
        cursor: pointer;
        font-weight: 600;
    }

    .more .cards {
        margin-top: var(--s-4);
    }

    .tools {
        display: flex;
        flex-wrap: wrap;
        gap: var(--s-2) var(--s-4);
        margin-top: var(--s-6);
        padding-top: var(--s-3);
        border-top: 1px solid var(--line-soft);
        font-size: 0.88rem;
    }

    @media (max-width: 52rem) {
        .cards {
            grid-template-columns: minmax(0, 1fr);
        }
    }
</style>
