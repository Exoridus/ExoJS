---
/**
 * BenchScoreboard - how one profile's comparisons came out, one line per arm.
 *
 * The line is per arm and never per backend or per domain: pooling two
 * opponents into one strip would show a reader a mix that belongs to neither of
 * them. Nothing is summed across lines and no line is ranked against another,
 * so the block counts outcomes without producing a score or an overall winner.
 *
 * Leads and losses are drawn with the same weight and differ only in hue, and
 * the two outcomes that carry no verdict - runs that disagreed, and arms that
 * produced no comparable cell - keep neither side's hue so a reader scanning
 * the strip cannot read one as a quiet win or a quiet loss.
 */

import { OUTCOME_LABELS, OUTCOME_ORDER, type ComparisonTally } from '../lib/bench-profiles';

interface Props {
    tallies: readonly ComparisonTally[];
}

const { tallies } = Astro.props;
---

{
    tallies.length > 0 && (
        <section class="scoreboard" aria-label="Comparison outcomes per arm">
            <div class="line head">
                <span class="pair">Pair</span>
                <span class="meta" />
                <span class="strip-head">leads left, losses right</span>
                <span class="counts" />
                <span class="total">rows</span>
            </div>
            {tallies.map(entry => (
                <div class="line">
                    <span class="pair">{entry.label}</span>
                    <span class="meta">{entry.meta}</span>
                    <span class="strip">
                        {OUTCOME_ORDER.filter(outcome => entry.counts[outcome] > 0).map(outcome => (
                            <span
                                class:list={['seg', outcome]}
                                style={`flex:${String(entry.counts[outcome])}`}
                                title={`${String(entry.counts[outcome])} ${OUTCOME_LABELS[outcome]}`}
                            />
                        ))}
                    </span>
                    <span class="counts">
                        {OUTCOME_ORDER.filter(outcome => entry.counts[outcome] > 0).map(outcome => (
                            <span class:list={['count', outcome]}>
                                <b>{entry.counts[outcome]}</b> {OUTCOME_LABELS[outcome]}
                            </span>
                        ))}
                    </span>
                    <span class="total">{entry.total}</span>
                </div>
            ))}
        </section>
    )
}

<style>
    .scoreboard {
        border: 1px solid var(--line-soft);
        border-radius: var(--r-3);
        background: var(--bg-elevated);
        padding: var(--s-3) var(--s-5) var(--s-4);
    }

    .line {
        display: grid;
        grid-template-columns: 11rem 7rem minmax(8rem, 20rem) minmax(16rem, 1fr) 3rem;
        column-gap: var(--s-4);
        align-items: center;
        padding: 0.34rem 0;
        border-top: 1px solid color-mix(in oklab, var(--line-soft), transparent 45%);
    }

    .line.head {
        border-top: 0;
        padding-bottom: 0.2rem;
    }

    .head span {
        font-family: var(--f-mono);
        font-size: 0.64rem;
        letter-spacing: 0.07em;
        text-transform: uppercase;
        color: var(--fg-faint);
    }

    .pair {
        font-family: var(--f-mono);
        font-size: 0.76rem;
    }

    .meta {
        font-family: var(--f-mono);
        font-size: 0.66rem;
        color: var(--fg-faint);
    }

    .strip {
        display: flex;
        gap: 2px;
        height: 8px;
    }

    .strip-head {
        text-align: center;
    }

    .counts {
        display: flex;
        flex-wrap: wrap;
        gap: 0 var(--s-3);
        font-family: var(--f-mono);
        font-size: 0.68rem;
        color: var(--fg-muted);
    }

    .total {
        font-family: var(--f-mono);
        font-size: 0.7rem;
        color: var(--fg-faint);
        text-align: right;
    }

    .seg {
        border-radius: 2px;
    }

    .seg.clear-lead {
        background: var(--bench-lead);
    }

    .seg.lead {
        background: color-mix(in oklab, var(--bench-lead), transparent 55%);
    }

    .seg.level {
        background: var(--fg-faint);
    }

    .seg.loss {
        background: color-mix(in oklab, var(--bench-loss), transparent 55%);
    }

    .seg.clear-loss {
        background: var(--bench-loss);
    }

    .seg.unstable {
        background: repeating-linear-gradient(90deg, var(--bench-mark) 0 2px, transparent 2px 5px);
    }

    .seg.absent {
        background: repeating-linear-gradient(90deg, var(--fg-faint) 0 1px, transparent 1px 4px);
    }

    .count b {
        font-weight: 700;
    }

    .count.clear-lead b,
    .count.lead b {
        color: var(--bench-lead);
    }

    .count.loss b,
    .count.clear-loss b {
        color: var(--bench-loss);
    }

    .count.unstable b {
        color: var(--bench-mark);
    }

    .count.absent b {
        color: var(--fg-muted);
    }

    @media (max-width: 900px) {
        .line {
            grid-template-columns: minmax(0, 1fr) auto;
            grid-template-areas: 'pair total' 'meta total' 'strip strip' 'counts counts';
            row-gap: 0.2rem;
        }

        .line.head {
            display: none;
        }

        .pair {
            grid-area: pair;
        }

        .meta {
            grid-area: meta;
        }

        .strip {
            grid-area: strip;
        }

        .counts {
            grid-area: counts;
        }

        .total {
            grid-area: total;
        }
    }
</style>
