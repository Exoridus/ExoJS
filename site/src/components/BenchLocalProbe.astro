---
/** A deliberately separate, browser-only probe. It never changes published profile data. */
---

<section id="run-locally" class="local-probe" aria-labelledby="local-probe-title">
    <div class="local-probe-copy">
        <p class="eyebrow">One local test, not a published comparison</p>
        <h2 id="local-probe-title">Run on this device</h2>
        <p>
            Raises a WebGL2 workload in this browser until a frame no longer fits in 16.7 ms, and reports the load this device carried at 60 fps. It measures one
            fixed workload rather than ExoJS against anything, is not a cross-library reference run, and is never mixed into the published comparisons.
        </p>
    </div>
    <div class="local-probe-actions">
        <button type="button" class="run" data-local-probe>Run local probe</button>
        <span class="status" data-local-status role="status" aria-live="polite">Idle</span>
    </div>
    <canvas class="probe-canvas" data-local-canvas width="640" height="360" aria-hidden="true"></canvas>
    <dl class="local-results" data-local-results hidden>
        <div>
            <dt>Quads at 60 fps</dt>
            <dd data-local-quads>-</dd>
        </div>
        <div>
            <dt>Frame at that load</dt>
            <dd data-local-frame>-</dd>
        </div>
        <div>
            <dt>Next step up</dt>
            <dd data-local-over>-</dd>
        </div>
        <div>
            <dt>Capabilities</dt>
            <dd data-local-capabilities>-</dd>
        </div>
    </dl>
</section>

<script is:inline>
    const localProbe = document.querySelector('[data-local-probe]');
    const localStatus = document.querySelector('[data-local-status]');
    const localResults = document.querySelector('[data-local-results]');
    const localCanvas = document.querySelector('[data-local-canvas]');

    /** One 60 fps frame, and the ceiling the ramp searches against. */
    const FRAME_BUDGET_MS = 16.7;

/**
     * Quads held in the vertex buffer, which fixes what the probe costs a
     * visitor in memory: 500,000 positions is 4 MB.
     */
    const BUFFER_QUADS = 500000;

    /**
     * Largest load the ramp will try.
     *
     * Reached by drawing the buffer repeatedly rather than by holding a buffer
     * this size - a current desktop GPU carries a few million quads inside a
     * frame, and a buffer that went there directly would cost half a gigabyte
     * to answer one question. A device that carries the whole ceiling reports
     * it as a floor, because what the probe found is that it ran out of
     * workload before the device ran out of budget.
     */
    const MAX_QUADS = 64000000;

    const median = values => {
        const sorted = [...values].sort((a, b) => a - b);
        return sorted[Math.floor(sorted.length / 2)] ?? 0;
    };

    const formatMs = value => (value < 0.005 ? '<0.01 ms' : `${value.toFixed(2)} ms`);
    const formatCount = value => value.toLocaleString('en-US');

    const compile = (gl, type, source) => {
        const shader = gl.createShader(type);
        if (shader === null) throw new Error('Could not create WebGL2 shader.');
        gl.shaderSource(shader, source);
        gl.compileShader(shader);
        if (!gl.getShaderParameter(shader, gl.COMPILE_STATUS)) throw new Error(gl.getShaderInfoLog(shader) ?? 'WebGL2 shader compilation failed.');
        return shader;
    };

    const runLocalProbe = onStep => {
        if (!(localCanvas instanceof HTMLCanvasElement)) throw new Error('Probe canvas is unavailable.');
        const gl = localCanvas.getContext('webgl2', { antialias: false, powerPreference: 'high-performance' });
        if (gl === null) throw new Error('WebGL2 is unavailable in this browser.');

        const vertex = compile(gl, gl.VERTEX_SHADER, '#version 300 es\nin vec2 position;\nvoid main(){gl_Position=vec4(position,0.0,1.0);gl_PointSize=4.0;}');
        const fragment = compile(gl, gl.FRAGMENT_SHADER, '#version 300 es\nprecision highp float;\nout vec4 color;\nvoid main(){color=vec4(0.25,0.65,1.0,1.0);}');
        const program = gl.createProgram();
        if (program === null) throw new Error('Could not create WebGL2 program.');
        gl.attachShader(program, vertex);
        gl.attachShader(program, fragment);
        gl.linkProgram(program);
        if (!gl.getProgramParameter(program, gl.LINK_STATUS)) throw new Error(gl.getProgramInfoLog(program) ?? 'WebGL2 program linking failed.');

        const positions = new Float32Array(BUFFER_QUADS * 2);
        for (let index = 0; index < BUFFER_QUADS; index += 1) {
            positions[index * 2] = ((index * 37) % 1000) / 500 - 1;
            positions[index * 2 + 1] = ((index * 91) % 1000) / 500 - 1;
        }
        const buffer = gl.createBuffer();
        gl.bindBuffer(gl.ARRAY_BUFFER, buffer);
        gl.bufferData(gl.ARRAY_BUFFER, positions, gl.STATIC_DRAW);
        gl.useProgram(program);
        const location = gl.getAttribLocation(program, 'position');
        gl.enableVertexAttribArray(location);
        gl.vertexAttribPointer(location, 2, gl.FLOAT, false, 0, 0);

        const readback = new Uint8Array(4);

        /**
         * Wall time for one frame's worth of work, never submission time: the
         * question is what the device completes inside a frame, and submission
         * returns long before the GPU has drawn anything.
         *
         * The single-pixel read is what makes that true. This canvas is never
         * presented - it is one transparent pixel off to the side - and without
         * a read the driver is free to defer or drop the draw entirely, which
         * reports two million quads as under a hundredth of a millisecond.
         * `finish()` alone does not force it.
         */
        const frameAt = count => {
            const samples = [];

            for (let index = 0; index < 8; index += 1) {
                const started = performance.now();
                gl.clearColor(0.02, 0.03, 0.06, 1);
                gl.clear(gl.COLOR_BUFFER_BIT);
                for (let drawn = 0; drawn < count; drawn += BUFFER_QUADS) {
                    gl.drawArrays(gl.POINTS, 0, Math.min(BUFFER_QUADS, count - drawn));
                }

                gl.readPixels(0, 0, 1, 1, gl.RGBA, gl.UNSIGNED_BYTE, readback);
                const elapsed = performance.now() - started;

                if (index >= 3) samples.push(elapsed);
            }

            return median(samples);
        };

        frameAt(50000);

        const started = performance.now();
        let carried = 0;
        let carriedMs = 0;
        let over = MAX_QUADS;
        let overMs = null;
        let count = 50000;

        // Double until a frame misses the budget, then halve the gap twice. Two
        // refinements put the answer inside about a quarter of the true ceiling,
        // which is the precision a single headline figure can carry anyway.
        while (count <= MAX_QUADS) {
            if (onStep) onStep(count);

            const ms = frameAt(count);

            if (ms > FRAME_BUDGET_MS) {
                over = count;
                overMs = ms;
                break;
            }

            carried = count;
            carriedMs = ms;

            if (count === MAX_QUADS) break;

            count = Math.min(count * 2, MAX_QUADS);
        }

        if (overMs !== null) {
            for (let step = 0; step < 2; step += 1) {
                const midpoint = Math.floor((carried + over) / 2);

                if (midpoint <= carried || midpoint >= over) break;

                if (onStep) onStep(midpoint);

                const ms = frameAt(midpoint);

                if (ms > FRAME_BUDGET_MS) {
                    over = midpoint;
                    overMs = ms;
                } else {
                    carried = midpoint;
                    carriedMs = ms;
                }
            }
        }

        return {
            carried,
            carriedMs,
            over: overMs === null ? null : over,
            overMs,
            ceiling: overMs === null,
            elapsed: performance.now() - started,
            webgpu: 'gpu' in navigator,
        };
    };

    localProbe?.addEventListener('click', () => {
        if (!(localStatus instanceof HTMLElement) || !(localResults instanceof HTMLElement) || !(localProbe instanceof HTMLButtonElement)) return;
        localProbe.disabled = true;
        localStatus.textContent = 'Raising the load...';

        try {
            const result = runLocalProbe(count => {
                localStatus.textContent = `Trying ${formatCount(count)} quads...`;
            });
            const quads = localResults.querySelector('[data-local-quads]');
            const frame = localResults.querySelector('[data-local-frame]');
            const overCell = localResults.querySelector('[data-local-over]');
            const capabilities = localResults.querySelector('[data-local-capabilities]');

            if (quads) quads.textContent = result.ceiling ? `${formatCount(result.carried)}+` : formatCount(result.carried);
            if (frame) frame.textContent = formatMs(result.carriedMs);
            if (overCell) overCell.textContent = result.over === null ? 'not reached' : `${formatCount(result.over)} took ${formatMs(result.overMs)}`;
            if (capabilities) capabilities.textContent = `WebGL2 · ${result.webgpu ? 'WebGPU available' : 'WebGPU unavailable'} · ${navigator.hardwareConcurrency ?? '?'} logical cores`;

            localResults.hidden = false;
            localStatus.textContent = result.ceiling
                ? `Carried the probe's largest load in ${result.elapsed.toFixed(0)} ms`
                : `Complete in ${result.elapsed.toFixed(0)} ms`;
        } catch (error) {
            localStatus.textContent = error instanceof Error ? error.message : 'Local probe failed.';
        } finally {
            localProbe.disabled = false;
        }
    });
</script>

<style>
    .local-probe {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: var(--s-4) var(--s-6);
        margin: var(--s-8) 0;
        padding: var(--s-5);
        border: 1px solid var(--line-soft);
        border-radius: var(--r-3);
        background: var(--bg-elevated);
    }

    .local-probe-copy h2,
    .local-probe-copy p { margin: 0; }
    /* The card's own border already separates it; the section rule prose gives an h2 draws a line through the middle of it. */
    .local-probe-copy h2 { margin-top: var(--s-1); padding-bottom: 0; border-bottom: 0; }
    .local-probe-copy p:last-child { max-width: 55rem; margin-top: var(--s-2); color: var(--fg-muted); }
    .eyebrow { color: var(--fg-faint); font: 600 0.68rem/1 var(--f-mono); letter-spacing: 0.08em; text-transform: uppercase; }
    .local-probe-actions { display: flex; align-items: center; gap: var(--s-3); justify-content: end; }
    .run { border: 1px solid var(--line); border-radius: var(--r-2); background: var(--fg); color: var(--bg-elevated); padding: 0.65rem 0.9rem; font: 600 0.78rem var(--f-mono); cursor: pointer; }
    .run:disabled { opacity: 0.6; cursor: wait; }
    .status { color: var(--fg-muted); font: 0.72rem var(--f-mono); }
    .probe-canvas { position: absolute; width: 1px; height: 1px; opacity: 0; pointer-events: none; }
    .local-results { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--s-3); margin: 0; }
    .local-results[hidden] { display: none; }
    .local-results div { padding-top: var(--s-3); border-top: 1px solid var(--line-soft); }
    .local-results dt { color: var(--fg-faint); font: 0.68rem var(--f-mono); text-transform: uppercase; }
    .local-results dd { margin: var(--s-1) 0 0; font: 0.82rem var(--f-mono); }
    @media (max-width: 48rem) {
        .local-probe { grid-template-columns: 1fr; }
        .local-probe-actions { justify-content: start; flex-wrap: wrap; }
        .local-results { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }
</style>
