---
/**
 * BenchProfileReport - one published machine profile, rendered whole.
 *
 * Everything on screen is read out of the profile document: the provenance, the
 * per-backend tables, the physics table, the disclosed caveats and the rows the
 * harness measured but kept out of the comparison. Nothing is authored here and
 * nothing is filtered out, so a re-measurement changes the page and no prose is
 * left behind that the numbers no longer support.
 *
 * A cell where ExoJS trails carries the same weight as one where it leads: the
 * two sides differ by hue and label, never by prominence. A missing cell is
 * shown as "not comparable" rather than dropped - an arm that sat an archetype
 * out or exceeded the harness's runaway budget produced no number, which is a
 * result and not a defect.
 *
 * Every published number is pooled from several separate runs, so every number
 * is printed with the range those runs observed underneath it, and a range wide
 * enough to reach into the verdict ladder's own noise band is marked rather than
 * left for the reader to compute. A cell whose runs reached different verdicts
 * prints none: it keeps its numbers and its range and states what each run
 * concluded instead.
 */

import BenchMeasurement from './BenchMeasurement.astro';
import {
    armsOfSection,
    BACKEND_LABELS,
    describeRungs,
    formatDay,
    formatRunTime,
    type BenchProfileDocument,
    type ProfileCell,
    type ProfileRow,
    type ProfileSection,
} from '../lib/bench-profiles';

interface Props {
    document: BenchProfileDocument;
    /** Heading level the block starts at, so a collapsed further machine does not outrank the reference. */
    headingLevel?: 2 | 3;
    /** Set false where the surrounding markup already names the machine, such as a collapsed further machine. */
    showTitle?: boolean;
}

const { document: profileDocument, headingLevel = 2, showTitle = true } = Astro.props;
const { profile, rendering, physics } = profileDocument;
const Heading = `h${String(headingLevel)}` as 'h2' | 'h3';
const SubHeading = `h${String(headingLevel + 1)}` as 'h3' | 'h4';

/**
 * What a cell publishes in its verdict column.
 *
 * The three outcomes are decided here and nowhere else, so no table can print a
 * verdict for a cell whose runs did not agree on one. An unstable cell gets its
 * own tone rather than a side, which keeps it out of the win/loss hues as well
 * as out of the win/loss words; its evidence is what each run concluded.
 */
const outcomeOf = (cell: ProfileCell | null) => {
    if (cell === null) {
        return { tone: 'absent', label: 'not comparable', rungs: null };
    }

    if (!cell.aggregate.stable) {
        return { tone: 'unstable', label: 'no verdict - the runs disagreed', rungs: describeRungs(cell.aggregate.rungs) };
    }

    return { tone: cell.verdict.side, label: cell.verdict.label, rungs: null };
};

/**
 * One archetype flattened into the table rows it occupies: one per arm the block
 * has a column for, with the arm's value left null where it produced no
 * comparable number. The ExoJS median is lifted onto the archetype because it is
 * the same measurement for every arm in the row, which also keeps it readable
 * when one arm is missing.
 */
const tableRows = (sections: readonly ProfileSection[], arms: readonly string[]) =>
    sections.flatMap(section =>
        section.rows.map((row: ProfileRow) => {
            const reference = row.cells.find(cell => cell.referenceMs !== null) ?? null;

            return {
                section: section.title,
                archetype: row.archetype,
                count: row.count,
                exojsMs: reference?.referenceMs ?? null,
                exojsSpread: reference?.aggregate.reference,
                entries: arms.map(arm => {
                    const cell = row.cells.find(candidate => candidate.competitor === arm) ?? null;

                    return {
                        arm,
                        armMs: cell?.competitorMs ?? null,
                        armSpread: cell?.aggregate.competitor,
                        outcome: outcomeOf(cell),
                        mechanism: cell?.mechanism ?? null,
                        present: cell !== null,
                    };
                }),
            };
        }),
    );

const renderingBlocks = (rendering?.backends ?? []).map(backend => {
    const webgl1Arms = [...new Set(backend.webgl1.flatMap(row => row.cells.map(cell => cell.competitor)))].sort();

    return {
        backend,
        rows: tableRows(backend.sections, backend.competitors),
        webgl1Arms,
        webgl1Rows: tableRows([{ title: 'WebGL1', rows: backend.webgl1 }], webgl1Arms),
    };
});

const physicsArms = physics === undefined ? [] : armsOfSection(physics.section);
const physicsRows = physics === undefined ? [] : tableRows([physics.section], physicsArms);

/** The machine is one across the pooled runs, so the first run's stamps name it for all of them. */
const renderingStamps = rendering?.runs[0]?.provenance ?? [];
const physicsHost = physics?.runs[0];

/**
 * When each pooled run was taken, per domain.
 *
 * The times are the point of the entry. A profile that named only its newest
 * measurement would read as one run, which is the reading the pooling exists to
 * prevent; seeing three separate stamps is what tells a reader the number above
 * them is a median over three measurements and not a single lucky one.
 */
const runTimes = [
    ...(rendering === undefined ? [] : [{ domain: 'Rendering', times: rendering.runs.map(run => run.provenance[0]?.timestamp ?? null) }]),
    ...(physics === undefined ? [] : [{ domain: 'Physics', times: physics.runs.map(run => run.timestamp) }]),
].map(entry => ({
    domain: entry.domain,
    times: entry.times.filter((time): time is string => time !== null).map(formatRunTime),
}));
---

<section class="profile">
    {showTitle && <Heading id={`profile-${profile.slug}`}>{profile.gpu} / {profile.os} / {profile.browser}</Heading>}

    <dl class="provenance">
        <div><dt>ExoJS</dt><dd>{profile.engineVersion}</dd></div>
        <div><dt>Measured</dt><dd>{formatDay(profile.measuredAt)}</dd></div>
        <div>
            <dt>Pooled runs</dt>
            <dd>
                {profile.runs} separate runs
                {runTimes.map(entry => (
                    <span class="detail">
                        {entry.domain}: {entry.times.join('; ')}
                    </span>
                ))}
            </dd>
        </div>
        <div><dt>Profile</dt><dd><code>{profile.slug}</code></dd></div>
        <div><dt>Signature</dt><dd><code>{profileDocument.signature.algorithm}:{profileDocument.signature.value.slice(0, 16)}</code></dd></div>
        {rendering !== undefined && (
            <div>
                <dt>Rendering arms</dt>
                <dd>{rendering.libraries.map(library => `${library.name} ${library.version}`).join(', ')}</dd>
            </div>
        )}
        {physics !== undefined && (
            <div>
                <dt>Physics arms</dt>
                <dd>{physics.libraries.map(library => `${library.name} ${library.version}`).join(', ')}</dd>
            </div>
        )}
        {renderingStamps.map(stamp => (
            <div>
                <dt>{BACKEND_LABELS[stamp.backend]} adapter</dt>
                <dd>
                    {stamp.adapter}
                    <span class="detail">
                        {stamp.headless ? 'headless' : 'headed'}, {stamp.software ? 'software rasterizer - timings untrusted' : 'hardware adapter'}
                        {stamp.slotTier === undefined ? '' : `, texture-slot tier ${String(stamp.slotTier)}`}
                        {stamp.flags.length === 0 ? '' : `, flags: ${stamp.flags.join(' ')}`}
                    </span>
                </dd>
            </div>
        ))}
        {physicsHost !== undefined && (
            <div>
                <dt>Physics host</dt>
                <dd>
                    {physicsHost.host.cpu}
                    <span class="detail">
                        {physicsHost.host.cpuCount} logical cores, {physicsHost.host.os} {physicsHost.host.arch}, {physicsHost.browser}{' '}
                        {physicsHost.browserVersion}, fixed step {(physicsHost.fixedDelta * 1000).toFixed(2)} ms
                    </span>
                </dd>
            </div>
        )}
    </dl>

    {renderingBlocks.map(block => (
        <section class="block">
            <SubHeading id={`${profile.slug}-${block.backend.backend}`}>Rendering on {BACKEND_LABELS[block.backend.backend]}</SubHeading>
            <p class="block-note">
                {block.backend.headlineCount === null
                    ? 'No single node count qualified for a headline table on this backend, so no rows are published for it.'
                    : `Every row is measured at ${String(block.backend.headlineCount)} nodes, chosen from the archetype ladders before any timing was read. Times are CPU milliseconds per frame, pooled over ${String(profile.runs)} separate runs as the median of their per-run medians; lower is better. The range under a time is what those runs observed.`}
            </p>

            {block.rows.length > 0 && (
                <div class="scroller">
                    <table>
                        <thead>
                            <tr>
                                <th scope="col">Archetype</th>
                                <th scope="col">ExoJS (ms)</th>
                                <th scope="col">Against</th>
                                <th scope="col">Arm (ms)</th>
                                <th scope="col">Verdict</th>
                                <th scope="col">Mechanism</th>
                            </tr>
                        </thead>
                        <tbody>
                            {block.rows.map(row =>
                                row.entries.map((entry, index) => (
                                    <tr class:list={[index === 0 && 'row-start']}>
                                        {index === 0 && (
                                            <th scope="row" rowspan={row.entries.length}>
                                                {row.archetype}
                                                <span class="category">{row.section}</span>
                                            </th>
                                        )}
                                        {index === 0 && (
                                            <td class="num" rowspan={row.entries.length}>
                                                <BenchMeasurement ms={row.exojsMs} spread={row.exojsSpread} />
                                            </td>
                                        )}
                                        <td class="arm">{entry.arm}</td>
                                        <td class="num">
                                            <BenchMeasurement ms={entry.armMs} spread={entry.armSpread} />
                                        </td>
                                        <td class="outcome">
                                            <span class:list={['verdict', entry.outcome.tone]}>{entry.outcome.label}</span>
                                            {entry.outcome.rungs !== null && <span class="rungs">{entry.outcome.rungs}</span>}
                                        </td>
                                        <td class="mechanism">
                                            {!entry.present
                                                ? `This arm produced no comparable cell at ${String(row.count)} nodes, so the pair is not published as a comparison.`
                                                : (entry.mechanism ?? 'No structural counters were reported for this pair.')}
                                        </td>
                                    </tr>
                                )),
                            )}
                        </tbody>
                    </table>
                </div>
            )}

            {block.webgl1Rows.length > 0 && (
                <div class="aside">
                    <h5>WebGL1 arms, CPU time only</h5>
                    <p>
                        These arms render through a WebGL1 context, so a gap against them can be caused by the backend generation as much as by the engine,
                        and the structural probe cannot attach to say which. The rows compare CPU time and carry no mechanism, which makes them an
                        observation rather than a finding.
                    </p>
                    <div class="scroller">
                        <table class="narrow">
                            <thead>
                                <tr>
                                    <th scope="col">Archetype</th>
                                    <th scope="col">ExoJS (ms)</th>
                                    <th scope="col">Against</th>
                                    <th scope="col">Arm (ms)</th>
                                    <th scope="col">Verdict</th>
                                </tr>
                            </thead>
                            <tbody>
                                {block.webgl1Rows.map(row =>
                                    row.entries.map((entry, index) => (
                                        <tr class:list={[index === 0 && 'row-start']}>
                                            {index === 0 && (
                                                <th scope="row" rowspan={row.entries.length}>
                                                    {row.archetype}
                                                </th>
                                            )}
                                            {index === 0 && (
                                                <td class="num" rowspan={row.entries.length}>
                                                    <BenchMeasurement ms={row.exojsMs} spread={row.exojsSpread} />
                                                </td>
                                            )}
                                            <td class="arm">{entry.arm}</td>
                                            <td class="num">
                                                <BenchMeasurement ms={entry.armMs} spread={entry.armSpread} />
                                            </td>
                                            <td class="outcome">
                                                <span class:list={['verdict', entry.outcome.tone]}>{entry.outcome.label}</span>
                                                {entry.outcome.rungs !== null && <span class="rungs">{entry.outcome.rungs}</span>}
                                            </td>
                                        </tr>
                                    )),
                                )}
                            </tbody>
                        </table>
                    </div>
                </div>
            )}

            {block.backend.excluded.length > 0 && (
                <details class="omissions">
                    <summary>{block.backend.excluded.length} archetypes measured but left out of this table</summary>
                    <ul>
                        {block.backend.excluded.map(entry => (
                            <li>
                                <code>{entry.archetype}</code> - {entry.reason}
                            </li>
                        ))}
                    </ul>
                </details>
            )}
        </section>
    ))}

    {physics !== undefined && (
        <section class="block">
            <SubHeading id={`${profile.slug}-physics`}>Physics</SubHeading>
            <p class="block-note">
                {physicsRows.length === 0
                    ? 'No single body count qualified for a headline table, so no physics rows are published.'
                    : `Every row is measured at ${String(physicsRows[0]?.count ?? 0)} bodies. Times are CPU milliseconds per fixed step, pooled over ${String(profile.runs)} separate runs as the median of their per-run medians; lower is better. The range under a time is what those runs observed.`}
            </p>

            {physicsRows.length > 0 && (
                <div class="scroller">
                    <table>
                        <thead>
                            <tr>
                                <th scope="col">Archetype</th>
                                <th scope="col">ExoJS (ms)</th>
                                <th scope="col">Against</th>
                                <th scope="col">Arm (ms)</th>
                                <th scope="col">Verdict</th>
                                <th scope="col">Mechanism</th>
                            </tr>
                        </thead>
                        <tbody>
                            {physicsRows.map(row =>
                                row.entries.map((entry, index) => (
                                    <tr class:list={[index === 0 && 'row-start']}>
                                        {index === 0 && (
                                            <th scope="row" rowspan={row.entries.length}>
                                                {row.archetype}
                                            </th>
                                        )}
                                        {index === 0 && (
                                            <td class="num" rowspan={row.entries.length}>
                                                <BenchMeasurement ms={row.exojsMs} spread={row.exojsSpread} />
                                            </td>
                                        )}
                                        <td class="arm">{entry.arm}</td>
                                        <td class="num">
                                            <BenchMeasurement ms={entry.armMs} spread={entry.armSpread} />
                                        </td>
                                        <td class="outcome">
                                            <span class:list={['verdict', entry.outcome.tone]}>{entry.outcome.label}</span>
                                            {entry.outcome.rungs !== null && <span class="rungs">{entry.outcome.rungs}</span>}
                                        </td>
                                        <td class="mechanism">
                                            {!entry.present
                                                ? `This arm produced no comparable cell at ${String(row.count)} bodies - it either sits this archetype out or exceeded the harness's runaway step budget there.`
                                                : (entry.mechanism ?? 'No structural counters were reported for this pair.')}
                                        </td>
                                    </tr>
                                )),
                            )}
                        </tbody>
                    </table>
                </div>
            )}

            {physicsHost !== undefined && physicsHost.caveats.length > 0 && (
                <details class="omissions">
                    <summary>{physicsHost.caveats.length} caveats the physics runs disclosed</summary>
                    <ul>
                        {physicsHost.caveats.map(caveat => (
                            <li>{caveat}</li>
                        ))}
                    </ul>
                </details>
            )}
        </section>
    )}

    <p class="verdict-key">
        <span class="verdict exojs">ExoJS leads</span>
        <span class="verdict competitor">the arm leads</span>
        <span class="verdict neither">level, inside the noise band</span>
        <span class="verdict unstable">no verdict - the runs disagreed</span>
        <span class="verdict absent">not comparable</span>
    </p>
    <p class="reading-key">
        The smaller line under a time is the range the {profile.runs} pooled runs observed for it. A range marked in amber spans a factor of 1.2 or more - as
        wide as the band the verdict ladder treats as noise - so the number above it is soft on this machine. A cell whose runs reached different verdicts
        publishes none of them and lists what each run concluded instead.
    </p>
</section>

<style>
    .profile {
        margin-top: var(--s-6);
    }

    .provenance {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(19rem, 1fr));
        gap: var(--s-2) var(--s-4);
        margin: 0 0 var(--s-6);
        padding: var(--s-4);
        border: 1px solid var(--line-soft);
        border-radius: var(--r-3);
        background: var(--bg-elevated);
        font-size: 0.82rem;
    }

    .provenance div {
        min-width: 0;
    }

    .provenance dt {
        color: var(--fg-faint);
        font-size: 0.72rem;
        letter-spacing: 0.05em;
        text-transform: uppercase;
    }

    .provenance dd {
        margin: 0.15rem 0 0;
        color: var(--fg);
        overflow-wrap: anywhere;
    }

    .provenance code {
        font-family: var(--f-mono);
        font-size: 0.76rem;
    }

    .detail {
        display: block;
        margin-top: 0.15rem;
        color: var(--fg-muted);
        font-size: 0.75rem;
    }

    .block {
        margin-bottom: var(--s-7);
    }

    .block-note {
        margin: 0 0 var(--s-3);
        color: var(--fg-muted);
        font-size: 0.85rem;
    }

    .scroller {
        overflow-x: auto;
        max-width: 100%;
        border: 1px solid var(--line-soft);
        border-radius: var(--r-3);
    }

    table {
        width: 100%;
        min-width: 62rem;
        border-collapse: collapse;
        font-size: 0.82rem;
    }

    table.narrow {
        min-width: 40rem;
    }

    th,
    td {
        padding: 0.5rem 0.7rem;
        text-align: left;
        vertical-align: top;
        border-bottom: 1px solid var(--line-soft);
    }

    thead th {
        background: var(--bg-elevated);
        font-weight: 600;
        white-space: nowrap;
    }

    tbody th {
        font-weight: 600;
        white-space: nowrap;
    }

    tbody tr:not(.row-start) td {
        border-top: 0;
    }

    tbody tr.row-start > * {
        border-top: 1px solid var(--line-soft);
    }

    .category {
        display: block;
        margin-top: 0.15rem;
        font-weight: 400;
        font-size: 0.72rem;
        color: var(--fg-faint);
    }

    .arm {
        font-family: var(--f-mono);
        font-size: 0.76rem;
        white-space: nowrap;
    }

    .num {
        font-family: var(--f-mono);
        font-size: 0.76rem;
        text-align: right;
        white-space: nowrap;
    }

    .outcome {
        min-width: 13rem;
    }

    .mechanism {
        min-width: 22rem;
        color: var(--fg-muted);
        font-size: 0.78rem;
        line-height: 1.5;
    }

    /*
     * Both sides of a comparison are drawn with the same weight, padding and
     * border; only the hue differs, and neither hue is the conventional
     * good/bad pair. A table that makes a loss quieter than a win stops being a
     * measurement.
     */
    .verdict {
        display: inline-block;
        padding: 0.15rem 0.45rem;
        border: 1px solid currentcolor;
        border-radius: var(--r-pill);
        font-size: 0.72rem;
        font-weight: 600;
        white-space: nowrap;
    }

    .verdict.exojs {
        color: var(--sky);
    }

    .verdict.competitor {
        color: var(--violet);
    }

    .verdict.neither {
        color: var(--fg-muted);
    }

    .verdict.absent {
        color: var(--amber);
    }

    /*
     * An unstable cell is deliberately given neither side's hue and a dashed
     * border: a reader scanning the colour alone must not be able to read it as
     * a quiet win, a quiet loss, or a settled "level".
     */
    .verdict.unstable {
        color: var(--fg-muted);
        border-style: dashed;
        white-space: normal;
    }

    .rungs {
        display: block;
        margin-top: 0.25rem;
        color: var(--fg-faint);
        font-size: 0.7rem;
        line-height: 1.45;
    }

    .aside {
        margin-top: var(--s-5);
        padding: var(--s-4);
        border: 1px solid var(--line-soft);
        border-radius: var(--r-3);
        background: var(--bg-elevated);
    }

    .aside h5 {
        margin: 0 0 0.35rem;
        font-size: 0.88rem;
    }

    .aside p {
        margin: 0 0 var(--s-3);
        color: var(--fg-muted);
        font-size: 0.82rem;
        line-height: 1.55;
    }

    .aside .scroller {
        background: var(--bg-canvas);
    }

    .omissions {
        margin-top: var(--s-4);
        border: 1px solid var(--line-soft);
        border-radius: var(--r-3);
        padding: var(--s-3) var(--s-4);
    }

    .omissions summary {
        cursor: pointer;
        font-size: 0.85rem;
        font-weight: 600;
    }

    .omissions ul {
        margin: var(--s-3) 0 0;
        padding-left: 1.1rem;
        color: var(--fg-muted);
        font-size: 0.8rem;
        line-height: 1.55;
    }

    .omissions code {
        font-family: var(--f-mono);
        color: var(--fg);
    }

    .verdict-key {
        display: flex;
        flex-wrap: wrap;
        gap: var(--s-2);
        margin: 0;
    }

    .reading-key {
        margin: var(--s-3) 0 0;
        max-width: 74ch;
        color: var(--fg-muted);
        font-size: 0.8rem;
        line-height: 1.55;
    }

    @media (max-width: 760px) {
        .provenance {
            grid-template-columns: 1fr;
        }

        .mechanism {
            min-width: 18rem;
        }
    }
</style>
