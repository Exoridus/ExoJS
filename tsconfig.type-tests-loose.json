{
  // `strictNullChecks: false` lane for the loader/catalog type contract.
  //
  // The engine and every project config are strict; this config exists purely so
  // the public type surface is also validated under a NON-strict consumer
  // tsconfig, where inference behaves differently (literal widening, collapsed
  // null/undefined unions). Scope is deliberately one file — it guards the
  // catalog-input overloads and the `Assets.from()` leaf inference that
  // `assets-strict-false.type-test.ts` was written for (whose name only became
  // accurate again with this config — the examples project it used to inherit
  // from turned strict).
  "extends": "./tsconfig.type-tests.json",
  "compilerOptions": {
    "strict": false,
    "strictNullChecks": false
  },
  "include": [
    "test/type-tests/loader-catalog-input.type-test.ts",
    "test/type-tests/loader-catalog-leaf.type-test.ts",
    "test/type-tests/assets-strict-false.type-test.ts",
    "src/typings.d.ts"
  ]
}
