{
  "name": "@codexo/exojs-build",
  "version": "0.1.0",
  "description": "Build-time Vite/Rollup plugins that load ExoJS shader files and inline typed AudioWorklet and Web Worker TypeScript modules as source strings.",
  "keywords": [
    "audioworklet",
    "glsl",
    "rollup-plugin",
    "vite-plugin",
    "web-worker",
    "wgsl",
    "worklet"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Exoridus/ExoJS.git",
    "directory": "packages/exojs-build"
  },
  "homepage": "https://github.com/Exoridus/ExoJS",
  "bugs": {
    "url": "https://github.com/Exoridus/ExoJS/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "default": "./dist/esm/index.js"
    },
    "./client": {
      "types": "./client.d.ts"
    },
    "./shader-strip": {
      "types": "./dist/esm/shaderStrip.d.ts",
      "import": "./dist/esm/shaderStrip.js",
      "default": "./dist/esm/shaderStrip.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/esm/",
    "client.d.ts",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.worklets.json",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "vitest run --root ../.. --project=exojs-build"
  },
  "dependencies": {
    "esbuild": "^0.28.2"
  },
  "devDependencies": {
    "rollup": "^4.63.1",
    "vite": "^7.3.5"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
