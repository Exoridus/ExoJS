{
  "name": "@codexo/exojs-module-particles",
  "version": "0.0.0",
  "private": true,
  "description": "Particle system extension for ExoJS. Source of the @codexo/exojs/particles subpath; built into and shipped with the Core package, never published on its own.",
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#*": {
      "@codexo/exojs-particles-source": "./src/*.ts"
    }
  },
  "scripts": {
    "typecheck": "exo-tsc --noEmit && exo-tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "vitest run --root ../.. --project=exojs-particles"
  },
  "devDependencies": {
    "@codexo/exojs": "workspace:*",
    "@codexo/exojs-config": "workspace:*"
  },
  "license": "MIT"
}
