{
  "extends": "@codexo/exojs-config/typescript/extension.json",
  "compilerOptions": {
    "customConditions": ["@codexo/exojs-source"],
    "paths": {
      "@codexo/exojs": ["../../src/index.ts"],
      "@codexo/exojs/extensions": ["../../src/extensions/index.ts"],
      "@codexo/exojs/renderer-sdk": ["../../src/renderer-sdk.ts"],
      "@codexo/exojs/debug": ["../../src/debug/index.ts"]
    }
  },
  "include": ["src/**/*", "src/typings.d.ts", "../../src/typings.d.ts"],
  // The `*.worklet.ts` sources typecheck against the AudioWorkletGlobalScope
  // (no DOM) via the dedicated tsconfig.worklets.json, not this package's main
  // DOM-lib program. None of them has an importer here — consumers reach them
  // exclusively through the `?worklet` query, which resolves to the ambient
  // `*?worklet` module declaration (src/typings.d.ts) rather than to the file
  // — so excluding them from `include` fully removes them from this program.
  // Leaving one in would let it compile against DOM globals it will not have
  // at runtime.
  "exclude": ["dist", "node_modules", "src/worklets/*.worklet.ts"]
}
