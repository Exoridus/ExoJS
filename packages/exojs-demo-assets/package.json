{
  "name": "@codexo/exojs-demo-assets",
  "version": "0.1.0",
  "description": "Optional demo media for ExoJS: typed, flat asset descriptors for textures, sounds, music, fonts, maps and video, with licences and a hash manifest.",
  "keywords": [
    "assets",
    "demo",
    "exojs",
    "game-assets"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Exoridus/ExoJS.git",
    "directory": "packages/exojs-demo-assets"
  },
  "homepage": "https://github.com/Exoridus/ExoJS",
  "bugs": {
    "url": "https://github.com/Exoridus/ExoJS/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./extended": {
      "types": "./dist/extended.d.ts",
      "import": "./dist/extended.js",
      "default": "./dist/extended.js"
    },
    "./manifest.json": "./manifest.json",
    "./media/*": "./media/*",
    "./package.json": "./package.json"
  },
  "bin": {
    "exojs-demo-assets-copy": "./bin/copy-media.js"
  },
  "files": [
    "dist/",
    "media/",
    "bin/",
    "manifest.json",
    "THIRD_PARTY_NOTICES.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "generate": "tsx scripts/generate.ts",
    "build": "tsx scripts/generate.ts --check --media && exo-tsc -p tsconfig.build.json",
    "archive": "tsx scripts/archive.ts",
    "typecheck": "exo-tsc --noEmit && exo-tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "vitest run --root ../.. --project=exojs-demo-assets --project=exojs test/assets/demo-assets-loading.test.ts"
  },
  "peerDependencies": {
    "@codexo/exojs": "0.20.x"
  },
  "devDependencies": {
    "@codexo/exojs": "workspace:*",
    "@codexo/exojs-config": "workspace:*"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
