{
  "name": "@codexo/exojs-config",
  "version": "0.0.0",
  "description": "Private shared tooling configuration for the ExoJS monorepo (TypeScript, ESLint, Prettier, Vitest, Rolldown, package policy). Not published.",
  "private": true,
  "type": "module",
  "bin": {
    "exo-tsc": "./bin/exo-tsc.js"
  },
  "exports": {
    "./eslint": "./eslint/index.js",
    "./eslint/base": "./eslint/base.js",
    "./eslint/correctness": "./eslint/correctness.js",
    "./eslint/extension": "./eslint/extension.js",
    "./eslint/package-test": "./eslint/package-test.js",
    "./eslint/react": "./eslint/react.js",
    "./eslint/style": "./eslint/style.js",
    "./eslint/vitest": "./eslint/vitest.js",
    "./prettier": "./prettier/index.js",
    "./vitest": "./vitest/index.js",
    "./rolldown": "./rolldown/index.js",
    "./build-defines": "./build-defines/index.js",
    "./package-policy": "./package-policy/index.js",
    "./typescript/base.json": "./typescript/base.json",
    "./typescript/compiler": "./typescript/compiler.js",
    "./typescript/consumer.json": "./typescript/consumer.json",
    "./typescript/library.json": "./typescript/library.json",
    "./typescript/extension.json": "./typescript/extension.json",
    "./typescript/test.json": "./typescript/test.json",
    "./typescript/package-test.json": "./typescript/package-test.json",
    "./typescript/worker.json": "./typescript/worker.json"
  },
  "dependencies": {
    "@codecov/rollup-plugin": "^2.0.1",
    "@codexo/exojs-build": "workspace:*",
    "@eslint-react/eslint-plugin": "^5.20.5",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@typescript/native": "npm:typescript@~7.0.2",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unicorn": "^76.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.12.0",
    "prettier-plugin-astro": "^1.1.0",
    "rolldown": "1.2.12",
    "typescript-eslint": "~8.70.1"
  },
  "license": "MIT"
}
