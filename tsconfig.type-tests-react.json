{
  // Type contract for packages/exojs-react's public hook/component surface.
  //
  // Extends the react package's own library profile so `jsx: "react-jsx"`
  // and its strict compiler baseline apply here too. `paths` is redeclared
  // (as an object, `extends` does not merge it key-by-key, so the base's
  // `@codexo/exojs` mapping must be repeated) to add `@codexo/exojs-react`
  // plus `react`/`react/jsx-runtime`, resolved through the react package's
  // own `node_modules` — the root package carries no react dependency of its
  // own, so a bare `react` specifier only resolves from there, and doing it
  // through the (pnpm-managed) symlink keeps this correct across a react
  // version bump without hardcoding a store hash.
  "extends": "./packages/exojs-react/tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "paths": {
      "@codexo/exojs": ["./src/index.ts"],
      "@codexo/exojs-react": ["./packages/exojs-react/src/index.ts"],
      "react": ["./packages/exojs-react/node_modules/@types/react"],
      "react/jsx-runtime": ["./packages/exojs-react/node_modules/@types/react/jsx-runtime"]
    }
  },
  "include": ["test/type-tests/exojs-react-surface.type-test.tsx", "src/typings.d.ts"]
}
