{
  // Backs ESLint's type-aware linting of test/**/*.ts (eslint.config.ts's
  // `project: ['./tsconfig.eslint.json']`). Its `include` is deliberately wide:
  // ESLint also needs type information for scripts/ and the root config files.
  //
  // Not to be confused with tsconfig.test.json, which is the *gate* for
  // test/** (`pnpm typecheck:test`). That one is narrower — it compiles only
  // the test tree, and it neutralises `rootDir`/emit so a program that spans
  // the repo root is legal.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "allowJs": true,
    "verbatimModuleSyntax": false,
    "isolatedModules": false,
    "ignoreDeprecations": "6.0",
    "types": ["vitest/globals", "node", "jsdom", "@webgpu/types", "css-font-loading-module"]
  },
  "include": ["src/**/*", "test/**/*", "eslint.config.ts", "rollup.config.ts", "scripts/**/*"]
}
